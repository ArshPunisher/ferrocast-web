---
// "What you get": real-looking alerts, chat and a moderation note floating in a calm 3D
// space. New alerts spring to the front of the stack while older ones recede. All sample
// data, so the whole visual is aria-hidden; the section around it carries the real text.
import Icon from './Icon.astro'
import BrandMark from './BrandMark.astro'

type Src = 'twitch' | 'youtube' | 'kick' | 'tip'
const alerts: { ico: string; t: string; amt?: string; m: string; src: Src }[] = [
  { ico: 'coins', t: 'Asha tipped', amt: '₹500', m: 'Chai is on me. Great stream!', src: 'tip' },
  { ico: 'heart', t: 'NovaRiver followed', m: 'Welcome to the channel', src: 'twitch' },
  { ico: 'users', t: 'Raid from mossbyte', m: '38 viewers are on their way', src: 'kick' },
  { ico: 'star', t: 'kestrel_92 subscribed', m: '12 months. Still here.', src: 'twitch' },
  { ico: 'chat-circle', t: 'Super Chat from Ira M.', amt: '₹200', m: 'Play the boss fight again', src: 'youtube' },
  { ico: 'lightning', t: 'pixelmonk cheered', amt: '500 bits', m: 'that clutch was unreal', src: 'twitch' },
]
const chats = [
  { p: 'twitch', n: 'pixelmonk', m: 'that clutch was unreal', pos: '222,152,40', mpos: '60,150,60' },
  { p: 'youtube', n: 'Rhea S', m: 'first time here, the overlay looks so clean', pos: '-215,200,-70', desk: true },
  { p: 'kick', n: 'drift0r', m: 'GG, same time tomorrow?', pos: '196,-222,-150', desk: true },
] as const
const moreChats = [
  ['twitch', 'saltwaterjay', 'which mic is that?'],
  ['youtube', 'Karan V', 'audio is perfect now'],
  ['kick', 'ottermode', 'raid incoming, hold on'],
  ['youtube', 'Mei Tan', 'watching from Pune'],
  ['twitch', 'nightjar_ttv', 'LETS GO'],
  ['kick', 'brassfox', 'the new alerts look great'],
] as const
---

<div class="astack-wrap">
<div class="astack" data-astack aria-hidden="true">
  <div class="wash"></div>
  <div class="rig-wrap">
    <div class="rig">
      {chats.map((c) => (
        <div class:list={['slot', { desk: 'desk' in c && c.desk }]} data-pos={c.pos} data-mpos={'mpos' in c ? c.mpos : undefined}>
          <div class="card chat">
            <span class:list={['g', c.p]}><BrandMark name={c.p} size={16} /></span>
            <span class="n" style={`color: var(--fc-${c.p})`}>{c.n}</span>
            <span class="m">{c.m}</span>
          </div>
        </div>
      ))}
      <div class="slot" data-pos="-175,-215,-30" data-mpos="-30,-150,-40">
        <div class="card mod">
          <span class="s"><Icon name="shield-check" weight="fill" size={16} /></span>
          <span>Spam link removed in <b>all 3 chats</b></span>
        </div>
      </div>
      {[2, 1, 0].map((i) => {
        const a = alerts[i]!
        return (
          <div class="q" data-i={i}>
            <div class="card alert">
              <div class="shade"></div>
              <div class="a-ico"><Icon name={a.ico} weight="fill" size={22} /></div>
              <div class="a-body">
                <div class="a-title">{a.t} {a.amt && <b>{a.amt}</b>}</div>
                <div class="a-msg">{a.m}</div>
              </div>
              <div class:list={['a-src', a.src]}>{a.src === 'tip' ? 'Tip page' : <BrandMark name={a.src} size={16} />}</div>
            </div>
          </div>
        )
      })}
    </div>
  </div>
  <template data-alerts>
    {alerts.map((a) => (
      <div class="card alert">
        <div class="shade"></div>
        <div class="a-ico"><Icon name={a.ico} weight="fill" size={22} /></div>
        <div class="a-body">
          <div class="a-title">{a.t} {a.amt && <b>{a.amt}</b>}</div>
          <div class="a-msg">{a.m}</div>
        </div>
        <div class:list={['a-src', a.src]}>{a.src === 'tip' ? 'Tip page' : <BrandMark name={a.src} size={16} />}</div>
      </div>
    ))}
  </template>
  <template data-chats>
    {moreChats.map(([p, n, m]) => (
      <div class="card chat">
        <span class:list={['g', p]}><BrandMark name={p} size={16} /></span>
        <span class="n" style={`color: var(--fc-${p})`}>{n}</span>
        <span class="m">{m}</span>
      </div>
    ))}
  </template>
</div>
<button type="button" class="vt-stack" data-astack-toggle aria-label="Pause animation" hidden>
  <span class="i-play"><Icon name="play" size={16} weight="fill" /></span>
  <span class="i-pause"><Icon name="pause" size={16} weight="fill" /></span>
</button>
</div>

<script>
  const host = document.querySelector<HTMLElement>('[data-astack]')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')

  if (host) {
    const rig = host.querySelector<HTMLElement>('.rig')!
    const wrap = host.querySelector<HTMLElement>('.rig-wrap')!
    const wash = host.querySelector<HTMLElement>('.wash')!
    const slots = [...host.querySelectorAll<HTMLElement>('.slot')]
    const alertTpl = [...(host.querySelector<HTMLTemplateElement>('[data-alerts]')?.content.children ?? [])] as HTMLElement[]
    const chatTpl = [...(host.querySelector<HTMLTemplateElement>('[data-chats]')?.content.children ?? [])] as HTMLElement[]
    const queue = [...host.querySelectorAll<HTMLElement>('.q')].reverse() // front first
    const pose = (i: number) => ({
      x: i * 22, y: -i * 30, z: 70 - i * 110, scale: 1 - i * 0.05,
      opacity: i < 3 ? 1 : 0, shade: [0, 0.42, 0.66, 0.66][Math.min(i, 3)] as number,
    })
    // measured on resize only: reading clientWidth between the per-slot transform writes
    // in place() would force a layout for every slot on every frame
    let narrow = host.clientWidth < 520
    const vec = (s: string | undefined) => (s ?? '0,0,0').split(',').map(Number) as [number, number, number]

    let scale = 1
    const size = () => {
      narrow = host.clientWidth < 520
      scale = narrow ? Math.min(1, host.clientWidth / 400) : Math.min(1.05, host.clientWidth / 720)
      wrap.style.transform = `translate(-50%, -50%) scale(${scale})`
    }
    const place = (t: number) => {
      for (const s of slots) {
        const [x, y, z] = vec(narrow && s.dataset.mpos ? s.dataset.mpos : s.dataset.pos)
        const fy = reduce.matches ? 0 : Math.sin(t * 0.7 + x * 0.01) * 7
        s.style.transform = `translate3d(${x}px, ${(y + fy).toFixed(2)}px, ${z}px)`
      }
    }
    // static composition first (also the reduced-motion version)
    const setStatic = () => {
      queue.forEach((q, i) => {
        q.toggleAttribute('data-front', i === 0)
        const p = pose(i)
        q.style.transform = `translate3d(${p.x}px, ${p.y}px, ${p.z}px) scale(${p.scale})`
        q.style.opacity = String(p.opacity)
        const sh = q.querySelector<HTMLElement>('.shade')
        if (sh) sh.style.opacity = String(p.shade)
      })
      rig.style.transform = 'rotateX(7deg) rotateY(-14deg)'
      place(0)
    }
    size()
    setStatic()
    addEventListener('resize', () => { size(); place(0) }, { passive: true })

    let visible = false
    let started = false
    let paused = false
    const toggle = document.querySelector<HTMLButtonElement>('[data-astack-toggle]')
    let raf = 0
    const pointer = { x: 0, y: 0, sx: 0, sy: 0, cx: -1, cy: -1 }
    // only the raw position here; it is mapped to the stack once per frame, in tick()
    addEventListener('pointermove', (e) => {
      if (!visible) return
      pointer.cx = e.clientX
      pointer.cy = e.clientY
    }, { passive: true })

    const run = async () => {
      if (started || reduce.matches) return
      started = true
      const { gsap } = await import('gsap')
      let alertIdx = 3, chatIdx = 0, chatSlot = 0, t = 0, last = 0, nextAlert = 1.6, nextChat = 2.4
      const push = () => {
        const tpl = alertTpl[alertIdx++ % alertTpl.length]
        if (!tpl) return
        const q = document.createElement('div')
        q.className = 'q'
        q.append(tpl.cloneNode(true))
        rig.append(q)
        queue.unshift(q)
        queue.forEach((el, i) => el.toggleAttribute('data-front', i === 0))
        queue.forEach((el, i) => {
          if (el === q) return
          const p = pose(i)
          gsap.to(el, { x: p.x, y: p.y, z: p.z, scale: p.scale, opacity: p.opacity, duration: 0.9, ease: 'expo.out' })
          gsap.to(el.querySelector('.shade'), { opacity: p.shade, duration: 0.6, ease: 'power2.out' })
        })
        gsap.set(q, { x: -10, y: 46, z: 150, scale: 0.92, opacity: 0, rotationX: -18 })
        gsap.to(q, { x: 0, y: 0, z: 70, scale: 1, opacity: 1, rotationX: 0, duration: 1.1, ease: 'elastic.out(1, 0.75)' })
        gsap.fromTo(wash, { opacity: 1.5 }, { opacity: 1, duration: 1.4, ease: 'power2.out' })
        while (queue.length > 4) {
          const old = queue.pop()!
          gsap.killTweensOf(old)
          old.remove()
        }
      }
      const swapChat = () => {
        const live = slots.filter((s) => s.querySelector('.chat') && !(narrow && s.classList.contains('desk')))
        const s = live[chatSlot++ % live.length]
        const tpl = chatTpl[chatIdx++ % chatTpl.length]
        const card = s?.querySelector<HTMLElement>('.chat')
        if (!s || !tpl || !card) return
        gsap.to(card, {
          opacity: 0, y: 8, duration: 0.3, ease: 'power2.in',
          onComplete() {
            const next = tpl.cloneNode(true) as HTMLElement
            card.replaceWith(next)
            gsap.fromTo(next, { opacity: 0, y: -8 }, { opacity: 1, y: 0, duration: 0.55, ease: 'power3.out' })
          },
        })
      }
      const tick = (now: number) => {
        raf = requestAnimationFrame(tick)
        const dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60
        last = now
        t += dt
        if (pointer.cx >= 0) {
          // read before this frame's writes, so it never forces a layout
          const r = host.getBoundingClientRect()
          pointer.x = ((pointer.cx - r.left) / Math.max(1, r.width)) * 2 - 1
          pointer.y = -(((pointer.cy - r.top) / Math.max(1, r.height)) * 2 - 1)
        }
        const k = 1 - Math.exp(-dt * 5)
        pointer.sx += (Math.max(-1, Math.min(1, pointer.x)) - pointer.sx) * k
        pointer.sy += (Math.max(-1, Math.min(1, pointer.y)) - pointer.sy) * k
        rig.style.transform = `rotateX(${(7 - pointer.sy * 6 + Math.sin(t * 0.17) * 1.5).toFixed(3)}deg) rotateY(${(-14 + pointer.sx * 9 + Math.sin(t * 0.21) * 2.5).toFixed(3)}deg)`
        place(t)
        if (t > nextAlert) { push(); nextAlert = t + 3.4 }
        if (t > nextChat) { swapChat(); nextChat = t + 1.7 }
      }
      const loop = () => {
        cancelAnimationFrame(raf)
        last = 0
        if (visible && !paused && !document.hidden && !reduce.matches) raf = requestAnimationFrame(tick)
      }
      document.addEventListener('visibilitychange', loop)
      reduce.addEventListener('change', () => {
        loop()
        if (!reduce.matches) return
        gsap.killTweensOf([...queue, wash, ...queue.flatMap((q) => [...q.querySelectorAll('.shade')])])
        setStatic()
      })
      ;(host as HTMLElement & { _loop?: () => void })._loop = loop
      // WCAG 2.2.2: anything that moves for more than five seconds can be paused
      if (toggle) {
        const sync = () => {
          toggle.dataset.playing = String(!paused)
          toggle.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation')
        }
        toggle.hidden = reduce.matches
        sync()
        toggle.addEventListener('click', () => { paused = !paused; sync(); loop() })
        reduce.addEventListener('change', () => { toggle.hidden = reduce.matches })
      }
      loop()
    }

    new IntersectionObserver(
      ([e]) => {
        visible = !!e?.isIntersecting
        if (visible) run()
        ;(host as HTMLElement & { _loop?: () => void })._loop?.()
      },
      { rootMargin: '120px 0px' },
    ).observe(host)
  }
</script>

<style>
  .astack-wrap {
    position: relative;
  }
  .vt-stack {
    display: grid;
    margin: 10px 4px 0 auto;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--fc-line-strong);
    background: color-mix(in srgb, var(--fc-surface-1) 82%, transparent);
    color: var(--fc-text);
    cursor: pointer;
    touch-action: manipulation;
    opacity: 0.85;
    transition:
      opacity 160ms var(--fc-ease-out),
      transform 120ms var(--fc-ease-out);
  }
  .vt-stack[hidden] {
    display: none;
  }
  .vt-stack:active {
    transform: scale(0.94);
  }
  .vt-stack .i-pause,
  .vt-stack[data-playing='true'] .i-play {
    display: none;
  }
  .vt-stack[data-playing='true'] .i-pause,
  .vt-stack .i-play {
    display: inline-flex;
  }
  @media (hover: hover) and (pointer: fine) {
    .vt-stack:hover {
      opacity: 1;
    }
  }
  .astack {
    --card: #171a1f;
    --card-line: rgb(255 255 255 / 0.08);
    --card-hi: rgb(255 255 255 / 0.07);
    --glow: 51 212 255;
    position: relative;
    height: clamp(360px, 42vw, 520px);
    overflow: hidden;
    border-radius: var(--fc-radius-panel);
    isolation: isolate;
  }
  :global(:root[data-theme='light']) .astack {
    --fc-kick: #13843a;
    --fc-youtube: #c80f29;
    --amt: #a35b00;
    --card: #ffffff;
    --card-line: rgb(14 16 20 / 0.07);
    --card-hi: #ffffff;
    --glow: 8 136 184;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark']):not([data-theme='light'])) .astack {
      --fc-kick: #13843a;
      --fc-youtube: #c80f29;
      --amt: #a35b00;
      --card: #ffffff;
      --card-line: rgb(14 16 20 / 0.07);
      --card-hi: #ffffff;
      --glow: 8 136 184;
    }
  }
  .wash {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--glow) / 0.16), rgb(var(--glow) / 0.05) 55%, transparent);
    z-index: -1;
  }
  .rig-wrap {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 0;
    height: 0;
    perspective: 1500px;
    transform: translate(-50%, -50%);
  }
  .rig,
  .slot,
  .q {
    position: absolute;
    left: 0;
    top: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .card {
    position: absolute;
    transform: translate(-50%, -50%);
    width: max-content;
    background: var(--card);
    color: var(--fc-text);
    border: 1px solid var(--card-line);
    border-radius: 16px;
    box-shadow:
      inset 0 1px 0 var(--card-hi),
      0 24px 60px -24px rgb(2 4 10 / 0.55),
      0 8px 18px -10px rgb(2 4 10 / 0.35);
    backface-visibility: hidden;
  }
  .shade {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--fc-bg);
    opacity: 0;
    pointer-events: none;
  }
  .alert {
    width: 372px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 16px 18px 16px 16px;
  }
  .a-ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--fc-surface-3);
    color: var(--fc-text-2);
  }
  .q[data-front] .a-ico {
    background: var(--fc-brand-arc);
    color: #06141b;
  }
  .a-title {
    font: 600 17px/1.25 var(--fc-font-display);
    letter-spacing: -0.015em;
  }
  .a-title b {
    font-weight: 700;
    color: var(--amt, var(--fc-accent));
  }
  .a-msg {
    margin-top: 3px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--fc-text-2);
  }
  .a-src {
    align-self: start;
    color: var(--fc-text-3);
  }
  .a-src.twitch {
    color: var(--fc-twitch);
  }
  .a-src.youtube {
    color: var(--fc-youtube);
  }
  .a-src.kick {
    color: var(--fc-kick);
  }
  .a-src.tip {
    font: 600 11px/1 var(--fc-font-sans);
    padding: 5px 8px;
    border: 1px solid var(--fc-line);
    border-radius: 999px;
  }
  .chat {
    max-width: 280px;
    padding: 11px 14px 12px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 9px;
  }
  .chat .g.twitch {
    color: var(--fc-twitch);
  }
  .chat .g.youtube {
    color: var(--fc-youtube);
  }
  .chat .g.kick {
    color: var(--fc-kick);
  }
  .chat .n {
    font: 600 14px/1.2 var(--fc-font-sans);
  }
  .chat .m {
    grid-column: 1 / -1;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .mod {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 999px;
    white-space: nowrap;
    font-size: 14px;
    color: var(--fc-text-2);
  }
  .mod .s {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--fc-accent-soft);
    color: var(--fc-accent-text);
  }
  .mod b {
    color: var(--fc-text);
    font-weight: 600;
  }
  @media (max-width: 519px) {
    .alert {
      width: 300px;
      padding: 13px 14px 13px 13px;
      gap: 12px;
    }
    .a-ico {
      width: 38px;
      height: 38px;
    }
    .a-title {
      font-size: 15.5px;
    }
    .a-msg {
      font-size: 13px;
    }
    .chat {
      max-width: 220px;
    }
    .slot.desk {
      display: none;
    }
  }
</style>
