---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import BrandMark from './BrandMark.astro'
import MiniBraid from './MiniBraid.astro'
import { ICON_PATHS } from '@ferrocast/ui/platform-icons'
import { COMPANY } from '../data/company'
import { API_ORIGIN } from '../data/api'
import { MENUS, PRICING_LINK, type NavItem } from '../data/nav'

const here = Astro.url.pathname
const hrefPath = (href: string) => href.split('#')[0] ?? href
// A link is "here" only for a page of its own, not for a #section of the features page.
const isHere = (it: NavItem) => !it.href.includes('#') && !it.external && hrefPath(it.href) === here
const groupHere = (key: string) =>
  MENUS.find((m) => m.key === key)?.groups.some((g) => g.items.some(isHere)) ?? false
const pricingHere = here === PRICING_LINK.href
const platforms = ['twitch', 'youtube', 'kick', 'facebook'] as const
---

<header class="site-header" data-mm>
  <div class="container bar">
    <a href="/" class="brand" aria-label="Ferrocast home" data-mm-close-on-hover>
      <Logo id="hdr" height={21} />
    </a>

    <nav aria-label="Main" class="mm-nav" data-mm-zone>
      <ul>
        {MENUS.map((m) => (
          <li>
            <button
              type="button"
              class="mm-trg"
              data-mm-trigger={m.key}
              data-here={groupHere(m.key) ? '' : undefined}
              aria-expanded="false"
              aria-controls={`mm-${m.key}`}
            >
              {m.label}
              <Icon name="caret-down" weight="bold" size={12} class="caret" />
            </button>
            <div
              class={`mm-view mm-${m.key}`}
              id={`mm-${m.key}`}
              data-mm-view={m.key}
              role="group"
              aria-label={m.label}
              inert
            >
              <div class="container a-grid">
                {m.groups.map((g, gi) => (
                  <div class="a-col">
                    <p class="a-h">{g.title}</p>
                    {g.items.map((it, i) => (
                      <a
                        class="mm-item"
                        href={it.href}
                        rel={it.external ? 'noopener' : undefined}
                        aria-current={isHere(it) ? 'page' : undefined}
                        style={`--i: ${gi * 3 + i}`}
                      >
                        <span class="tile">
                          <Icon name={it.icon} weight="light" size={20} />
                        </span>
                        <span class="mm-txt">
                          <b>{it.title}</b>
                          <span>{it.desc}</span>
                        </span>
                      </a>
                    ))}
                  </div>
                ))}
                {m.key === 'features' && (
                  <aside class="a-card">
                    <div class="a-card-art">
                      <MiniBraid id="mb" />
                    </div>
                    <h3>Multistream, free</h3>
                    <p>Go live on every platform at once, from your own PC.</p>
                    <div class="a-card-row">
                      <span class="plats" role="img" aria-label="Twitch, YouTube, Kick, Facebook">
                        {platforms.map((p) => (
                          <svg
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            fill={`var(--fc-${p})`}
                            aria-hidden="true"
                          >
                            <path d={ICON_PATHS[p]} />
                          </svg>
                        ))}
                      </span>
                      <a class="btn btn-primary btn-sm" href="/features/multistream/">
                        See how
                        <Icon name="arrow-right" weight="bold" size={14} class="ic-go" />
                      </a>
                    </div>
                  </aside>
                )}
                {m.key === 'usecases' && (
                  <aside class="a-card a-card-quiet">
                    <h3>Not sure where to start?</h3>
                    <p>Install the app, connect one platform and go live. The rest can wait.</p>
                    <a class="btn btn-primary btn-sm" href="/download/">
                      Download
                      <Icon name="arrow-right" weight="bold" size={14} class="ic-go" />
                    </a>
                  </aside>
                )}
                {m.key === 'resources' && (
                  <aside class="a-card a-card-quiet">
                    <h3>Open source</h3>
                    <p>Read the code, report a bug or build it yourself.</p>
                    <a class="btn btn-secondary btn-sm" href={COMPANY.github} rel="noopener">
                      <BrandMark name="github" size={16} />
                      View on GitHub
                    </a>
                  </aside>
                )}
              </div>
              <div class="a-foot">
                <div class="container a-foot-in">
                  <span>Free and open source. No account needed.</span>
                  {m.key === 'features' && <a href="/features/">See every feature</a>}
                </div>
              </div>
            </div>
          </li>
        ))}
        <li>
          <a
            class="mm-trg"
            href={PRICING_LINK.href}
            aria-current={pricingHere ? 'page' : undefined}
          >
            {PRICING_LINK.label}
          </a>
        </li>
      </ul>
    </nav>

    <div class="actions" data-mm-close-on-hover>
      <button type="button" class="icon-btn theme-btn" data-theme-cycle>
        <span class="t-i t-system">
          <Icon name="monitor" size={18} />
        </span>
        <span class="t-i t-light">
          <Icon name="sun" size={18} />
        </span>
        <span class="t-i t-dark">
          <Icon name="moon" size={18} />
        </span>
        <span class="sr-only" data-theme-label>
          Theme: System. Switch to Light
        </span>
      </button>
      <a href={COMPANY.github} class="icon-btn gh" aria-label="Ferrocast on GitHub" rel="noopener">
        <BrandMark name="github" size={18} />
      </a>
      <!-- Signed out: Sign in. Signed in (checked with the server): the avatar and Open dashboard. -->
      <a href="/login/" class="acct" data-acct data-api={API_ORIGIN}>
        <span class="acct-av" data-acct-av hidden></span>
        <span data-acct-label>Sign in</span>
      </a>
      <a href="/download/" class="btn btn-primary btn-sm cta" data-bot-excite>
        Download
      </a>
      <button
        type="button"
        class="burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mm-burger
      >
        <span class="sr-only">Menu</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mm-scrim" aria-hidden="true"></div>
  <div class="dscrim" data-mm-dscrim aria-hidden="true"></div>
  <div
    id="mobile-menu"
    class="drawer"
    data-mm-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    inert
  >
    <div class="d-head">
      <Logo id="drw" height={20} />
      <button type="button" class="burger is-x" data-mm-drawer-close>
        <span class="sr-only">Close menu</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <nav aria-label="Main mobile" class="d-body">
      {MENUS.map((m) => (
        <div class="acc" data-acc>
          <button
            type="button"
            class="acc-btn"
            data-acc-btn
            aria-expanded="false"
            aria-controls={`acc-${m.key}`}
          >
            <span>{m.label}</span>
            <Icon name="caret-down" weight="bold" size={14} class="caret" />
          </button>
          <div class="acc-panel" id={`acc-${m.key}`}>
            <div class="acc-inner">
              {m.groups.map((g) => (
                <div class="acc-group">
                  {m.groups.length > 1 && <p class="acc-h">{g.title}</p>}
                  {g.items.map((it) => (
                    <a
                      class="mm-item"
                      href={it.href}
                      aria-current={isHere(it) ? 'page' : undefined}
                    >
                      <span class="tile">
                        <Icon name={it.icon} weight="light" size={20} />
                      </span>
                      <span class="mm-txt">
                        <b>{it.title}</b>
                        <span>{it.desc}</span>
                      </span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
      <a class="acc-link" href={PRICING_LINK.href} aria-current={pricingHere ? 'page' : undefined}>
        {PRICING_LINK.label}
      </a>
      <a class="acc-link" href={COMPANY.github} rel="noopener">
        GitHub
        <Icon name="arrow-up-right" size={18} />
      </a>
    </nav>
    <div class="d-foot">
      <a href="/download/" class="btn btn-primary">
        Download Ferrocast
      </a>
      <a href="/login/" class="btn btn-secondary" data-acct-mobile>
        Sign in
      </a>
    </div>
  </div>
</header>

<script>
  import { initMegaMenu } from '../scripts/mega-menu'
  const header = document.querySelector<HTMLElement>('[data-mm]')
  if (header) initMegaMenu(header)

  // Who's signed in, from the server (the API host shares this site's cookie scope). Any
  // failure leaves "Sign in", which is always a working link.
  const acct = document.querySelector<HTMLAnchorElement>('[data-acct]')
  const acctMobile = document.querySelector<HTMLAnchorElement>('[data-acct-mobile]')
  if (acct?.dataset.api) {
    fetch(`${acct.dataset.api}/v1/account`, {
      credentials: 'include',
      headers: { Accept: 'application/json' },
    })
      .then((r) => (r.ok ? r.json() : null))
      .then(
        (
          v: {
            account?: { name?: string | null; email?: string; avatar_url?: string | null } | null
          } | null,
        ) => {
          // Signed in: a 200 with the account (signed out is a 401).
          if (!v?.account) return
          const name = v.account?.name?.trim() || (v.account?.email ?? '').split('@')[0] || 'You'
          const av = acct.querySelector<HTMLElement>('[data-acct-av]')!
          const url = v.account?.avatar_url
          if (url && url.startsWith('https://')) {
            const img = document.createElement('img')
            img.src = url
            img.alt = ''
            img.referrerPolicy = 'no-referrer'
            img.width = 24
            img.height = 24
            av.append(img)
          } else {
            av.textContent = name.slice(0, 1).toUpperCase()
          }
          av.hidden = false
          acct.querySelector('[data-acct-label]')!.textContent = 'Open dashboard'
          acct.href = '/app/'
          acct.classList.add('in')
          acct.setAttribute('aria-label', `Open dashboard, signed in as ${name}`)
          if (acctMobile) {
            acctMobile.textContent = 'Open dashboard'
            acctMobile.href = '/app/'
          }
        },
      )
      .catch(() => {})
  }

  // Theme: one button that cycles System -> Light -> Dark. System follows the OS and saves
  // nothing; Light and Dark are saved on this device.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-cycle]')
  const themeLabel = themeBtn?.querySelector<HTMLElement>('[data-theme-label]')
  const MODES = ['system', 'light', 'dark'] as const
  type Mode = (typeof MODES)[number]
  const NAMES: Record<Mode, string> = { system: 'System', light: 'Light', dark: 'Dark' }
  const saved = (): Mode => {
    const t = document.documentElement.dataset.theme
    return t === 'light' || t === 'dark' ? t : 'system'
  }
  const mark = () => {
    if (!themeBtn || !themeLabel) return
    const now = saved()
    const next = MODES[(MODES.indexOf(now) + 1) % MODES.length]!
    themeBtn.title = `Theme: ${NAMES[now]}`
    themeLabel.textContent = `Theme: ${NAMES[now]}. Switch to ${NAMES[next]}`
  }
  mark()
  themeBtn?.addEventListener('click', () => {
    const pick = MODES[(MODES.indexOf(saved()) + 1) % MODES.length]!
    const root = document.documentElement
    const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
    if (pick === 'light' || pick === 'dark') {
      root.dataset.theme = pick
      // an explicit choice overrides the OS-based browser chrome colour
      metas.forEach((m) => m.setAttribute('content', pick === 'light' ? '#f2f3f6' : '#0a0b0d'))
    } else {
      delete root.dataset.theme
      // back to the OS: each meta goes back to the colour for its own media query
      metas.forEach((m) =>
        m.setAttribute('content', m.media.includes('light') ? '#f2f3f6' : '#0a0b0d'),
      )
    }
    try {
      if (pick === 'light' || pick === 'dark') localStorage.setItem('fc-theme', pick)
      else localStorage.removeItem('fc-theme')
    } catch {
      /* private mode: the choice lasts for this page only */
    }
    mark()
    document.dispatchEvent(new CustomEvent('fc-theme', { detail: saved() }))
  })
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    /* solid, so page text never shows through the bar while scrolling */
    background: var(--fc-bg);
    border-bottom: 1px solid var(--fc-line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--fc-text);
    text-decoration: none;
    margin-right: auto;
    border-radius: 8px;
  }

  /* ---- desktop: triggers in the bar, one panel under it */
  .mm-nav {
    display: none;
    align-self: stretch;
  }
  .mm-nav ul {
    display: flex;
    height: 100%;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mm-nav li {
    display: flex;
    align-items: center;
  }
  .mm-trg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 12px;
    border-radius: 8px;
    border: 0;
    background: none;
    color: var(--fc-text-2);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 160ms var(--fc-ease-out),
      background-color 160ms var(--fc-ease-out);
  }
  .mm-trg :global(.caret) {
    color: var(--fc-text-3);
    transition: transform 220ms var(--fc-ease-out);
  }
  .mm-trg[aria-expanded='true'] {
    color: var(--fc-text);
    background: var(--fc-surface-3);
  }
  .mm-trg[aria-expanded='true'] :global(.caret) {
    transform: rotate(180deg);
  }
  .mm-trg[data-here],
  .mm-trg[aria-current='page'] {
    color: var(--fc-text);
  }
  @media (hover: hover) and (pointer: fine) {
    .mm-trg:hover {
      color: var(--fc-text);
    }
  }
  .mm-scrim {
    position: fixed;
    left: 0;
    right: 0;
    top: 64px;
    bottom: 0;
    z-index: -1;
    background: rgb(8 12 18 / 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--fc-ease-out);
  }
  .site-header[data-open] .mm-scrim {
    opacity: 1;
  }
  .mm-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    background: var(--fc-bg);
    border-bottom: 1px solid var(--fc-line);
    box-shadow: var(--fc-shadow-pop);
    transform: translateY(-8px);
    transition:
      opacity 160ms var(--fc-ease-out),
      transform 240ms var(--fc-ease-out),
      visibility 0s 240ms;
  }
  .mm-view.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: none;
    transition-delay: 0s;
  }
  .a-grid {
    display: grid;
    gap: 8px 28px;
    padding-block: 28px 30px;
    align-items: start;
  }
  .mm-features .a-grid {
    grid-template-columns: 1.05fr 1.05fr 0.9fr 1.15fr;
  }
  .mm-usecases .a-grid {
    grid-template-columns: repeat(2, minmax(0, 360px));
    justify-content: start;
  }
  .mm-resources .a-grid {
    grid-template-columns: repeat(3, minmax(0, 340px));
    justify-content: start;
  }
  .a-h {
    padding: 0 10px 8px;
    color: var(--fc-text-3);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .a-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mm-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px;
    border-radius: 12px;
    color: var(--fc-text);
    text-decoration: none;
  }
  .mm-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mm-txt b {
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .mm-txt span {
    margin-top: 2px;
    color: var(--fc-text-3);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--fc-line);
    background: var(--fc-surface-2);
    color: var(--fc-text-2);
    transition:
      background-color 200ms var(--fc-ease-out),
      color 200ms var(--fc-ease-out),
      border-color 200ms var(--fc-ease-out);
  }
  .mm-item[aria-current='page'] .tile {
    background: var(--fc-btn-soft);
    color: var(--fc-molten-text);
    border-color: transparent;
  }
  .mm-view .mm-item {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms var(--fc-ease-out),
      transform 260ms var(--fc-ease-out),
      background-color 160ms var(--fc-ease-out);
  }
  .mm-view.is-open .mm-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i, 0) * 22ms + 40ms), calc(var(--i, 0) * 22ms + 40ms), 0s;
  }
  @media (hover: hover) and (pointer: fine) {
    .mm-view .mm-item:hover {
      background: var(--fc-surface-3);
      transition-delay: 0s;
    }
    .mm-item:hover .tile {
      background: var(--fc-btn-soft);
      color: var(--fc-molten-text);
      border-color: transparent;
    }
  }
  .mm-view .mm-item:focus-visible {
    background: var(--fc-surface-3);
    outline-offset: -2px;
  }
  .a-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    overflow: hidden;
    border-radius: var(--fc-radius-panel);
    background: var(--fc-canvas);
    color: #e9eff5;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    --fc-twitch: #a970ff;
    --fc-youtube: #ff3b4e;
    --fc-kick: #53fc18;
    --fc-facebook: #6aa5ff;
    --fc-brand-arc: #33d4ff;
    --fc-brand-molten: #ffa424;
  }
  .a-card h3 {
    color: #f3f6fa;
    font-size: 1.25rem;
  }
  .a-card p {
    color: #bccad8;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .a-card-art {
    margin: -4px -4px 4px;
  }
  .a-card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }
  .plats {
    display: inline-flex;
    gap: 10px;
  }
  .a-card-quiet {
    background: var(--fc-surface-2);
    color: var(--fc-text);
    border: 1px solid var(--fc-line);
    box-shadow: none;
  }
  .a-card-quiet h3 {
    color: var(--fc-text);
  }
  .a-card-quiet p {
    color: var(--fc-text-2);
  }
  .a-card-quiet .btn {
    align-self: flex-start;
    margin-top: 6px;
  }
  .mm-view.is-open :global(.braid path) {
    animation: braid-draw 900ms var(--fc-ease-out) both;
  }
  @keyframes braid-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .a-foot {
    border-top: 1px solid var(--fc-line);
    background: var(--fc-surface-2);
  }
  .a-foot-in {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 12px;
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
  .a-foot-in a {
    color: var(--fc-accent-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- the bar's right side */
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--fc-radius-control);
    color: var(--fc-text-2);
    background: none;
    border: 0;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color 160ms var(--fc-ease-out),
      background-color 160ms var(--fc-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .icon-btn:hover {
      color: var(--fc-text);
      background: var(--fc-surface-2);
    }
  }
  .icon-btn:active {
    transform: scale(0.94);
  }
  /* theme button: only the current mode's icon shows; each click turns to the next */
  .t-i {
    display: none;
  }
  /* read straight from <html>, set before first paint, so the icon is right from the start */
  :global(html:not([data-theme])) .t-system,
  :global(html[data-theme='light']) .t-light,
  :global(html[data-theme='dark']) .t-dark {
    display: inline-flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    .theme-btn .t-i {
      animation: theme-in 240ms var(--fc-ease-out);
    }
  }
  @keyframes theme-in {
    from {
      opacity: 0;
      transform: rotate(-60deg) scale(0.6);
    }
  }
  .gh,
  .cta,
  .acct {
    display: none;
  }
  .acct {
    align-items: center;
    gap: 8px;
    height: 36px;
    padding-inline: 10px;
    border-radius: 999px;
    color: var(--fc-text-2);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .acct.in {
    padding-left: 4px;
    border: 1px solid var(--fc-line-strong);
    background: var(--fc-surface-1);
    color: var(--fc-text);
  }
  .acct-av {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    overflow: hidden;
