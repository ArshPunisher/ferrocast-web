---
// Questions as native details elements: keyboard and screen reader friendly, no script.
import Icon from './Icon.astro'
interface Props {
  items: { q: string; a: string }[]
}
const { items } = Astro.props
---

<div class="qa-list">
  {items.map((i) => (
    <details>
      <summary>
        {i.q}
        <Icon name="plus" weight="bold" size={18} />
      </summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>

<style>
  .qa-list {
    max-width: 860px;
  }
  details {
    border-top: 1px solid var(--fc-line);
  }
  details:last-child {
    border-bottom: 1px solid var(--fc-line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 650;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    flex: none;
    color: var(--fc-text-3);
    transition: transform 240ms var(--fc-ease-out);
  }
  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  details p {
    max-width: 62ch;
    padding-bottom: 22px;
    color: var(--fc-text-2);
  }
</style>
