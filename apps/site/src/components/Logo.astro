---
// The lockup (Spark mark + outlined wordmark) drawn inline: letters and the f in
// currentColor, the shard and the live dot from the theme tokens, so it follows the theme.
// `id` keeps the wordmark's mask unique when the header and footer both render it.
import { BRAND_PAINT_THEMED, lockupParts } from '../../../../packages/ui/src/brand.ts'
interface Props {
  id: string
  height?: number
}
const { id, height = 26 } = Astro.props
const l = lockupParts(BRAND_PAINT_THEMED, `${id}-o`)
const width = Math.round((l.width / l.height) * height)
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={l.viewBox}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
  set:html={l.inner}
/>
