---
// The wordmark from brand/ with the text drawn in currentColor, so it follows the theme.
// Gradient ids get a per-instance suffix so header and footer copies don't collide.
import raw from '../../../../brand/logo-wordmark-dark.svg?raw'
interface Props {
  id: string
  height?: number
}
const { id, height = 26 } = Astro.props
const svg = raw
  .replace(/id="wd-/g, `id="${id}-`)
  .replace(/url\(#wd-/g, `url(#${id}-`)
  .replace(/fill="#eef0f4"/g, 'fill="currentColor"')
  .replace(/<svg ([^>]*?)width="(\d+)" height="120"/, (_m, rest: string, w: string) => {
    const width = Math.round((Number(w) / 120) * height)
    return `<svg ${rest}width="${width}" height="${height}" aria-hidden="true" focusable="false"`
  })
  .replace(/ role="img" aria-label="Ferrocast"/, '')
---

<Fragment set:html={svg} />
