---
// The interactive ferrofluid: a WebGL puddle whose spikes follow the pointer like a magnet.
// The SVG mark sits underneath as the first paint, the fallback without WebGL and the
// still image under reduced motion. The canvas fades in only once its first frame drew.
import { SPIKE_MARK_PATH, MARK_MAGNET } from '../../../../packages/ui/src/ferro/mark.ts'
---

<div class="ferro" data-ferro>
  <svg class="fallback" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="hero-c" x1="0" y1="14" x2="0" y2="60" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--fc-text)"></stop>
        <stop offset="0.5" stop-color="var(--fc-text-3)"></stop>
        <stop offset="1" stop-color="var(--fc-surface-3)"></stop>
      </linearGradient>
    </defs>
    <path d={SPIKE_MARK_PATH} fill="url(#hero-c)"></path>
    <circle
      cx={MARK_MAGNET.cx}
      cy={MARK_MAGNET.cy}
      r={MARK_MAGNET.r}
      fill="var(--fc-accent)"
    ></circle>
  </svg>
  <canvas aria-hidden="true"></canvas>
</div>

<script>
  import { mountFerrofluid } from '@ferrocast/ui/ferro'

  const host = document.querySelector<HTMLElement>('[data-ferro]')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')
  let stop: (() => void) | null = null
  // Real GPUs only: software renderers (SwiftShader, llvmpipe) would draw the raymarch on
  // the CPU and stall the page, so they get the still SVG instead.
  const webgl = (() => {
    try {
      const gl = document.createElement('canvas').getContext('webgl')
      if (!gl) return false
      const info = gl.getExtension('WEBGL_debug_renderer_info')
      const renderer = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : ''
      gl.getExtension('WEBGL_lose_context')?.loseContext()
      return !/swiftshader|llvmpipe|softpipe|software|basic render/i.test(renderer)
    } catch {
      return false
    }
  })()

  const theme = () =>
    document.documentElement.dataset.theme ??
    (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')

  const start = () => {
    stop?.()
    stop = null
    if (!host) return
    host.classList.remove('ready')
    // Restart on the same canvas: dispose() keeps the WebGL context for one tick, and a new
    // renderer on that canvas claims it, so theme changes never leak contexts.
    const canvas = host.querySelector('canvas')
    if (!canvas || !webgl) return
    const light = theme() === 'light'
    stop = mountFerrofluid(canvas, {
      background: light ? '#f2f3f6' : '#0a0b0d',
      accent: '#3461f5',
      light,
      reducedMotion: reduce.matches,
      idlePauseMs: 12_000,
      onReady: () => host.classList.add('ready'),
    })
  }

  // Start after first paint so the canvas never competes with the headline for LCP.
  const go = () => {
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window
        ? requestIdleCallback(cb, { timeout: 1200 })
        : setTimeout(cb, 200)
    requestAnimationFrame(() => idle(start))
  }
  if (document.readyState === 'complete') go()
  else addEventListener('load', go, { once: true })
  document.addEventListener('fc-theme', start)
  reduce.addEventListener('change', start)
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', start)
</script>

<style>
  .ferro {
    position: relative;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(farthest-side at 50% 48%, #000 58%, transparent 100%);
    mask-image: radial-gradient(farthest-side at 50% 48%, #000 58%, transparent 100%);
  }
  .fallback {
    position: absolute;
    left: 50%;
    top: 54%;
    width: min(46%, 260px);
    height: auto;
    transform: translate(-50%, -50%);
    transition: opacity 600ms var(--fc-ease-out);
  }
  .ferro :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--fc-ease-out);
    touch-action: pan-y;
  }
  .ready :global(canvas) {
    opacity: 1;
  }
  .ready .fallback {
    opacity: 0;
  }
</style>
