---
// Platform marks from Simple Icons (CC0), used only to name what Ferrocast works with.
import { ICON_PATHS, type IconName } from '@ferrocast/ui/platform-icons'
interface Props {
  name: IconName
  size?: number
  label?: string
  class?: string
}
const { name, size = 20, label, class: className } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={ICON_PATHS[name]}></path>
</svg>
