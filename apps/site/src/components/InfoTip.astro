---
// The (i) pattern: details behind a small button. Opens on tap, hover and keyboard focus;
// Escape or a tap elsewhere closes it. It slides sideways when it would leave the screen.
interface Props {
  label: string
  id: string
}
const { label, id } = Astro.props
---

<span class="info" data-info>
  <button type="button" aria-label={label} aria-expanded="false" aria-describedby={id}>
    i
  </button>
  <span class="tip" role="tooltip" id={id}>
    <slot />
  </span>
</span>

<script>
  const infos = [...document.querySelectorAll<HTMLElement>('[data-info]')]
  const place = (i: HTMLElement) => {
    const tip = i.querySelector<HTMLElement>('.tip')
    if (!tip) return
    tip.style.setProperty('--sx', '0px')
    const r = tip.getBoundingClientRect()
    const vw = document.documentElement.clientWidth
    let sx = 0
    if (r.right > vw - 12) sx = vw - 12 - r.right
    if (r.left + sx < 12) sx = 12 - r.left
    tip.style.setProperty('--sx', `${sx}px`)
  }
  const closeAll = () =>
    infos.forEach((i) => {
      i.classList.remove('open')
      i.querySelector('button')?.setAttribute('aria-expanded', 'false')
    })
  // "dismissed" beats the hover and focus rules, so Escape or a second tap really hides a tip
  // that is still hovered or focused. A new hover or focus, or opening it again, clears it.
  const show = (i: HTMLElement) => {
    i.classList.remove('dismissed')
    place(i)
  }
  const isShown = (i: HTMLElement) =>
    i.classList.contains('open') || i.matches(':focus-within') || i.matches(':hover')
  for (const i of infos) {
    const b = i.querySelector('button')
    b?.addEventListener('click', (e) => {
      e.stopPropagation()
      const on = !i.classList.contains('open')
      closeAll()
      i.classList.toggle('open', on)
      b.setAttribute('aria-expanded', String(on))
      if (on) show(i)
      else i.classList.add('dismissed')
    })
    i.addEventListener('pointerenter', () => show(i))
    b?.addEventListener('focus', () => show(i))
  }
  document.addEventListener('click', closeAll)
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return
    // focus stays on the button; only the tip goes away
    for (const i of infos) if (isShown(i)) i.classList.add('dismissed')
    closeAll()
  })
</script>

<style is:global>
  .info {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
    margin-left: 6px;
  }
  .info > button {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--fc-line-strong);
    border-radius: 999px;
    background: var(--fc-surface-1);
    color: var(--fc-text-2);
    font: 700 0.75rem var(--fc-font-mono);
    cursor: pointer;
  }
  .info .tip {
    display: none;
    position: absolute;
    z-index: 20;
    left: 50%;
    bottom: calc(100% + 10px);
    width: max-content;
    max-width: min(280px, 72vw);
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--fc-canvas);
    color: #e9eff5;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    text-align: left;
    box-shadow: var(--fc-shadow-pop);
    transform: translateX(calc(-50% + var(--sx, 0px)));
  }
  .info.open:not(.dismissed) .tip,
  .info:focus-within:not(.dismissed) .tip {
    display: block;
  }
  @media (hover: hover) {
    .info:hover:not(.dismissed) .tip {
      display: block;
    }
    .info > button:hover {
      border-color: var(--fc-text-3);
      color: var(--fc-text);
    }
  }
</style>
