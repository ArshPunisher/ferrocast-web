---
// Hero station: Twitch, YouTube and Kick braid into one Arc channel that lands in the Spark.
// The strands are WebGL inside this box only (never behind the headline). The chips are
// HTML placed on the strands; the SVG is the drawing for browsers without WebGL or JS.
import Station from './Station.astro'
import { ICON_PATHS } from '@ferrocast/ui/platform-icons'
import { BRAND_PAINT_THEMED, sparkShapes } from '@ferrocast/ui/brand'
const spark = sparkShapes(BRAND_PAINT_THEMED)

const streams = [
  { name: 'twitch', y: 70 },
  { name: 'youtube', y: 210 },
  { name: 'kick', y: 350 },
] as const
const offsets = [-14, -9, -4, 0, 4, 9, 14]
const strand = (y: number, o: number) =>
  `M560 ${y + o} C 420 ${y + o} 380 ${210 + o * 0.45} 270 ${210 + o * 0.4} S 160 ${210 + o * 0.1} 122 210`
---

<Station kind="hero" class="hero-station">
  <div class="braid-fallback">
    <svg viewBox="0 0 600 420" preserveAspectRatio="xMidYMid meet">
      <defs>
        {streams.map((s) => (
          <linearGradient
            id={`hb-${s.name}`}
            x1="560"
            y1="0"
            x2="230"
            y2="0"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color={`var(--fc-${s.name})`} />
            <stop offset="1" stop-color="var(--fc-brand-arc)" />
          </linearGradient>
        ))}
      </defs>
      {streams.map((s) => (
        <g fill="none" stroke={`url(#hb-${s.name})`} stroke-width="1.4" opacity="0.85">
          {offsets.map((o) => (
            <path d={strand(s.y, o)} />
          ))}
        </g>
      ))}
      <svg
        x="44"
        y="172"
        width="76"
        height="76"
        viewBox="0 0 64 64"
        class="spark"
        set:html={spark}
      />
      {streams.map((s) => (
        <svg
          x="556"
          y={s.y - 12}
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill={`var(--fc-${s.name})`}
        >
          <path d={ICON_PATHS[s.name]}></path>
        </svg>
      ))}
    </svg>
  </div>
  {streams.map((s) => (
    <div class={`chip-3d ${s.name}`} data-chip={s.name}>
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d={ICON_PATHS[s.name]}></path>
      </svg>
    </div>
  ))}
  <div class="chip-3d home" data-chip="home">
    <svg viewBox="0 0 64 64" class="spark" set:html={spark} />
  </div>
</Station>

<style>
  .braid-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }
  :global(.station.live) .braid-fallback {
    opacity: 0;
    transition: opacity 600ms var(--fc-ease-out);
  }
  .braid-fallback > svg {
    width: 100%;
    height: auto;
    max-height: 100%;
  }
  .spark {
    color: var(--fc-text);
  }
  .chip-3d {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: var(--fc-surface-1);
    border: 1px solid var(--fc-line-strong);
    box-shadow: 0 10px 30px -12px rgb(2 4 10 / 0.5);
  }
  .chip-3d svg {
    width: 20px;
    height: 20px;
  }
  .twitch {
    color: var(--fc-twitch);
  }
  .youtube {
    color: var(--fc-youtube);
  }
  .kick {
    color: var(--fc-kick);
  }
  .home {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--fc-surface-2);
  }
  .home svg {
    width: 40px;
    height: 40px;
  }
  @media (min-width: 1440px) {
    .chip-3d {
      width: clamp(42px, 3vw, 54px);
      height: clamp(42px, 3vw, 54px);
    }
    .chip-3d svg {
      width: clamp(20px, 1.45vw, 26px);
      height: clamp(20px, 1.45vw, 26px);
    }
    .home {
      width: clamp(64px, 4.5vw, 80px);
      height: clamp(64px, 4.5vw, 80px);
      border-radius: 18px;
    }
    .home svg {
      width: clamp(40px, 2.8vw, 50px);
      height: clamp(40px, 2.8vw, 50px);
    }
  }
  @media (max-width: 899px) {
    .chip-3d {
      width: 36px;
      height: 36px;
    }
    .chip-3d svg {
      width: 17px;
      height: 17px;
    }
    .home {
      width: 54px;
      height: 54px;
    }
    .home svg {
      width: 34px;
      height: 34px;
    }
  }
</style>
