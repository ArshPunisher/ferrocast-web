---
// One stream fanning out to the platforms. Tap or press a platform to switch it off and on,
// like the switches in the Studio. Decorative strands and packets; the switches are the
// real controls.
import { ICON_PATHS } from '@ferrocast/ui/platform-icons'
import { BRAND_PAINT_THEMED, sparkShapes } from '@ferrocast/ui/brand'

interface Props {
  id: string
  /** On a dark stage: bright platform colours whatever the page theme. */
  stage?: boolean
}
const { id, stage = false } = Astro.props
const spark = sparkShapes(BRAND_PAINT_THEMED)
const plats = [
  { k: 'twitch', n: 'Twitch', y: 62 },
  { k: 'youtube', n: 'YouTube', y: 160 },
  { k: 'kick', n: 'Kick', y: 258 },
  { k: 'facebook', n: 'Facebook', y: 356 },
] as const
const d = (y: number, o: number) =>
  `M 150 ${210 + o * 0.5} C 270 ${210 + o * 0.5} 280 ${y + o * 0.5} 436 ${y + o * 0.5}`
---

<div class:list={['fan', { stage }]} data-fan>
  <svg
    class="fan-svg"
    viewBox="0 0 640 420"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
  >
    <g class="fan-strands" fill="none" stroke-width="1.3">
      {plats.map((p, i) => (
        <g class="fan-s" data-p={p.k}>
          <defs>
            <linearGradient
              id={`${id}-g${i}`}
              x1="150"
              y1="0"
              x2="436"
              y2="0"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color="var(--fc-brand-arc)"></stop>
              <stop offset="1" stop-color={`var(--fc-${p.k})`}></stop>
            </linearGradient>
          </defs>
          {[-6, 0, 6].map((o, j) => (
            <path
              id={o === 0 ? `${id}-m${i}` : undefined}
              d={d(p.y, o)}
              pathLength="1"
              stroke={`url(#${id}-g${i})`}
              style={`--j: ${i * 3 + j}`}
            ></path>
          ))}
          <circle r="3.2" fill={`var(--fc-${p.k})`} class="pk" visibility="hidden">
            <set attributeName="visibility" to="visible" begin={`${(i * 0.7).toFixed(1)}s`}></set>
            <animateMotion
              dur="3.6s"
              begin={`${(i * 0.7).toFixed(1)}s`}
              repeatCount="indefinite"
              calcMode="spline"
              keyTimes="0;1"
              keySplines=".4 0 .6 1"
            >
              <mpath href={`#${id}-m${i}`}></mpath>
            </animateMotion>
          </circle>
          <circle r="2.4" fill="var(--fc-brand-arc)" class="pk" visibility="hidden">
            <set
              attributeName="visibility"
              to="visible"
              begin={`${(i * 0.7 + 1.8).toFixed(1)}s`}
            ></set>
            <animateMotion
              dur="3.6s"
              begin={`${(i * 0.7 + 1.8).toFixed(1)}s`}
              repeatCount="indefinite"
              calcMode="spline"
              keyTimes="0;1"
              keySplines=".4 0 .6 1"
            >
              <mpath href={`#${id}-m${i}`}></mpath>
            </animateMotion>
          </circle>
        </g>
      ))}
    </g>
    <circle class="hub-pulse" cx="96" cy="210" r="46"></circle>
    <circle class="hub" cx="96" cy="210" r="46"></circle>
    <svg x="58" y="172" width="76" height="76" viewBox="0 0 64 64" class="spark" set:html={spark} />
  </svg>
  <span class="fan-pc">Your PC</span>
  {plats.map((p) => (
    <button
      type="button"
      class="fan-chip"
      role="switch"
      aria-checked="true"
      data-p={p.k}
      style={`left: ${(436 / 640) * 100}%; top: ${(p.y / 420) * 100}%`}
    >
      <span class="fc-ic">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill={`var(--fc-${p.k})`}
          aria-hidden="true"
        >
          <path d={ICON_PATHS[p.k]}></path>
        </svg>
      </span>
      <span class="fc-n">{p.n}</span>
      <span class="fc-sw" aria-hidden="true"></span>
    </button>
  ))}
  <p class="fan-going" aria-live="polite">
    Going to <b data-n>4</b> <span data-places>places</span>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fan]').forEach((fan) => {
    const chips = [...fan.querySelectorAll<HTMLButtonElement>('.fan-chip')]
    const n = fan.querySelector<HTMLElement>('[data-n]')
    const places = fan.querySelector<HTMLElement>('[data-places]')
    const sync = () => {
      const on = chips.filter((c) => c.getAttribute('aria-checked') === 'true').length
      if (n) n.textContent = String(on)
      if (places) places.textContent = on === 1 ? 'place' : 'places'
    }
    for (const c of chips)
      c.addEventListener('click', () => {
        const on = c.getAttribute('aria-checked') !== 'true'
        c.setAttribute('aria-checked', String(on))
        fan.querySelector(`.fan-s[data-p="${c.dataset.p}"]`)?.classList.toggle('off', !on)
        sync()
      })
    // under reduced motion the packets stay out; the strands are drawn already
    if (matchMedia('(prefers-reduced-motion: reduce)').matches)
      fan.querySelectorAll<SVGElement>('.pk').forEach((p) => (p.style.display = 'none'))
  })
</script>

<style>
  .fan {
    position: relative;
    width: 100%;
    aspect-ratio: 640 / 420;
    container-type: inline-size;
  }
  .fan-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .fan-strands path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: fan-draw 1400ms var(--fc-ease-out) forwards;
    animation-delay: calc(260ms + var(--j, 0) * 55ms);
  }
  @keyframes fan-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .fan-s {
    transition: opacity 360ms var(--fc-ease-out);
  }
  .fan-s.off {
    opacity: 0.1;
  }
  .fan-s.off .pk {
    display: none;
  }
  .hub {
    fill: var(--fc-surface-1);
    stroke: var(--fc-line-strong);
    stroke-width: 1.5;
  }
  .hub-pulse {
    fill: none;
    stroke: var(--fc-brand-arc);
    stroke-width: 1.4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: hub-pulse 3.2s var(--fc-ease-out) 1.2s infinite;
  }
  @keyframes hub-pulse {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.55);
    }
  }
  .spark {
    color: var(--fc-text);
  }
  .fan-pc {
    position: absolute;
    left: 15%;
    top: calc(54% + 28px);
    transform: translateX(-50%);
    color: var(--fc-text-3);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .fan-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    width: calc(204 / 640 * 100%);
    height: 48px;
    padding: 0 12px;
    border-radius: 12px;
    border: 1px solid var(--fc-line-strong);
    background: var(--fc-surface-1);
    color: var(--fc-text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 650;
    cursor: pointer;
    box-shadow: var(--fc-shadow-2);
    opacity: 0;
    transform: translate(0, -50%);
    animation: chip-in 600ms var(--fc-ease-out) 900ms forwards;
    transition:
      opacity 300ms var(--fc-ease-out),
      border-color 200ms var(--fc-ease-out);
  }
  .fan-chip:nth-of-type(2) {
    animation-delay: 960ms;
  }
  .fan-chip:nth-of-type(3) {
    animation-delay: 1020ms;
  }
  .fan-chip:nth-of-type(4) {
    animation-delay: 1080ms;
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translate(10px, -50%);
    }
    to {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }
  .fan-chip:active {
    transform: translate(0, -50%) scale(0.97);
  }
  .fc-n {
    flex: 1;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fc-sw {
    position: relative;
    flex: none;
    width: 30px;
    height: 18px;
    border-radius: 999px;
    background: var(--fc-ok-fill, #13865a);
    transition: background-color 220ms var(--fc-ease-out);
  }
  .fc-sw::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 14px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    transition: transform 240ms var(--fc-ease-out);
  }
  .fan-chip[aria-checked='false'] {
    animation: none;
    opacity: 0.6;
  }
  .fan-chip[aria-checked='false'] .fc-sw {
    background: var(--fc-line-strong);
  }
  .fan-chip[aria-checked='false'] .fc-sw::after {
    transform: translateX(-12px);
  }
  .fan-chip[aria-checked='false'] .fc-ic {
    filter: grayscale(1);
    opacity: 0.7;
  }
  @media (hover: hover) {
    .fan-chip:hover {
      border-color: var(--fc-text-3);
    }
  }
  .fan-going {
    position: absolute;
    left: 0;
    bottom: -6px;
    color: var(--fc-text-2);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .fan-going b {
    color: var(--fc-text);
    font-family: var(--fc-font-mono);
  }
  @container (max-width: 560px) {
    .fc-sw {
      display: none;
    }
  }
  @container (max-width: 420px) {
    .fan-chip {
      justify-content: center;
      width: calc(86 / 640 * 100%);
      padding: 0 10px;
      gap: 8px;
    }
    .fc-n,
    .fc-sw {
      display: none;
    }
    .fan-going {
      font-size: 0.875rem;
    }
  }
  .stage {
    --fc-text: #e9eff5;
    --fc-text-2: #bccad8;
    --fc-text-3: #96a6b6;
    --fc-surface-1: #1d2833;
    --fc-line-strong: #3d4e60;
    --fc-twitch: #a970ff;
    --fc-youtube: #ff3b4e;
    --fc-kick: #53fc18;
    --fc-facebook: #6aa5ff;
    --fc-brand-arc: #33d4ff;
    --fc-brand-molten: #ffa424;
    color: #e9eff5;
  }
  @media (prefers-reduced-motion: reduce) {
    .fan-strands path,
    .fan-chip {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
    }
    .hub-pulse {
      animation: none;
    }
  }
</style>
