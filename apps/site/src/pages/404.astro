---
import Base from '../layouts/Base.astro'
import { SPARK } from '../../../../packages/ui/src/brand.ts'

const page = {
  path: '/404/',
  title: 'Page not found | Ferrocast',
  description:
    'This page does not exist. It may have moved or the link may be wrong. Head back to the Ferrocast home page, the features or the FAQ to find what you need.',
  ogTitle: 'Page not found',
  ogKicker: 'Ferrocast',
  crumb: 'Not found',
}
---

<Base page={page} noindex>
  <section class="nf container">
    <svg viewBox="0 0 64 64" width="120" height="120" aria-hidden="true">
      <path d={SPARK.f} fill="var(--fc-text-3)" opacity="0.5"></path>
      <path d={SPARK.boltTop} style="fill: var(--fc-brand-molten)"></path>
      <path d={SPARK.boltBottom} style="fill: var(--fc-brand-arc)"></path>
    </svg>
    <h1 class="display-2">This page isn’t here.</h1>
    <p class="lede">It may have moved, or the link may be wrong.</p>
    <div class="links">
      <a href="/" class="btn btn-primary">
        Go home
      </a>
      <a href="/features/" class="btn btn-secondary">
        Features
      </a>
      <a href="/faq/" class="btn btn-ghost">
        FAQ
      </a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 20px;
    padding-block: 72px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
</style>
