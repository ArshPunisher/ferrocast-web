---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Icon from '../components/Icon.astro'
import { PAGES } from '../data/pages'
import { SITE } from '../data/company'
import { COMPARE, SOURCES, type Mark } from '../data/compare'
import { webPage } from '../data/schema'

const page = PAGES.compare
const cols = [
  { key: 'ferrocast', name: 'Ferrocast' },
  { key: 'streamelements', name: 'StreamElements' },
  { key: 'streamlabs', name: 'Streamlabs' },
] as const
const markIcon: Record<Mark, { icon: string; sr: string }> = {
  yes: { icon: 'check-circle', sr: 'Yes.' },
  partial: { icon: 'circle-half', sr: 'Partly.' },
  no: { icon: 'minus-circle', sr: 'No.' },
  unknown: { icon: 'question', sr: '' },
  info: { icon: 'dot-outline', sr: '' },
}
---

<Base
  page={page}
  schema={[webPage(page.title, new URL(page.path, SITE.url).href, page.description)]}
>
  <section class="head">
    <div class="container head-inner">
      <Breadcrumbs page={page} />
      <h1 class="display-2">How Ferrocast compares.</h1>
      <p class="lede">
        StreamElements and Streamlabs are the tools most streamers start with. Here is what each one
        does, side by side, as of October 2026.
      </p>
      <p class="note">
        <Icon name="info" size={18} />
        <!-- prettier-ignore -->
        <span>Ferrocast is still being built; its column describes version 1. Corrections are welcome on <a href="/contact/" class="text-link">our contact page</a>.</span>
      </p>
    </div>
  </section>

  <section class="container">
    <!-- Explicit roles: on phones the table is restyled as blocks, which drops them. -->
    <table class="cmp" role="table">
      <caption class="sr-only">Ferrocast, StreamElements and Streamlabs compared</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">
            <span class="sr-only">Topic</span>
          </th>
          {cols.map((c) => (
            <th scope="col" role="columnheader" class:list={[c.key === 'ferrocast' && 'us']}>
              {c.name}
            </th>
          ))}
        </tr>
      </thead>
      {COMPARE.map((g) => (
        <tbody role="rowgroup">
          <tr class="group-row" role="row">
            <th scope="colgroup" colspan="4" role="rowheader">
              {g.title}
            </th>
          </tr>
          {g.rows.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {r.topic}
              </th>
              {cols.map((c) => {
                const cell = r[c.key]
                const m = markIcon[cell.mark]
                return (
                  <td
                    role="cell"
                    data-label={c.name}
                    class:list={[c.key === 'ferrocast' && 'us', `m-${cell.mark}`]}
                  >
                    <span class="cell">
                      <Icon
                        name={m.icon}
                        size={18}
                        weight={cell.mark === 'info' || cell.mark === 'unknown' ? 'bold' : 'fill'}
                      />
                      <span>
                        {m.sr && <span class="sr-only">{m.sr} </span>}
                        {cell.text}
                      </span>
                    </span>
                  </td>
                )
              })}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </section>

  <section class="section">
    <div class="container fine">
      <div>
        <h2 class="display-3">Sources</h2>
        <p class="muted">
          Checked in October 2026. “Not documented” means we could not find it in the vendor’s
          public docs, not that it can never be done.
        </p>
      </div>
      <div>
        <ul class="sources">
          {SOURCES.map((s) => (
            <li>
              <a href={s.url} rel="noopener nofollow" class="text-link">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="tm">
          StreamElements is a trademark of StreamElements Inc. Streamlabs is a trademark of
          Logitech. Twitch, YouTube and Kick are trademarks of their owners. Names are used only to
          identify the products compared; Ferrocast is not affiliated with any of them.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: 40px 32px;
  }
  .head-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 1024px) {
    .head {
      padding-block: 72px 48px;
    }
  }
  .note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--fc-text-2);
    font-size: 0.9375rem;
    max-width: 70ch;
  }
  .note :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--fc-accent-text);
  }
  .cmp {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .cmp thead th {
    font-family: var(--fc-font-display);
    font-size: 1.05rem;
    letter-spacing: -0.015em;
    text-align: left;
    color: var(--fc-text);
    padding: 16px 14px;
    position: sticky;
    top: 64px;
    background: var(--fc-bg);
    border-bottom: 1px solid var(--fc-line-strong);
    z-index: 1;
  }
  .cmp thead th.us {
    color: var(--fc-accent-text);
  }
  .group-row th {
    text-align: left;
    padding: 32px 14px 10px;
    font-family: var(--fc-font-sans);
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--fc-text-3);
    letter-spacing: 0.02em;
  }
  tbody tr:not(.group-row) th {
    text-align: left;
    font-weight: 600;
    color: var(--fc-text);
    padding: 14px;
    vertical-align: top;
    width: 22%;
  }
  tbody td {
    padding: 14px;
    vertical-align: top;
    color: var(--fc-text-2);
  }
  tbody tr:not(.group-row) {
    border-top: 1px solid var(--fc-line);
  }
  td.us {
    background: color-mix(in srgb, var(--fc-accent-soft) 45%, transparent);
    color: var(--fc-text);
  }
  .cell {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .cell :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .m-yes :global(svg) {
    color: var(--fc-ok);
  }
  .m-partial :global(svg) {
    color: var(--fc-warn);
  }
  .m-no :global(svg),
  .m-unknown :global(svg),
  .m-info :global(svg) {
    color: var(--fc-text-3);
  }

  /* Phones: each row becomes a block with labelled answers. */
  @media (max-width: 767px) {
    .cmp thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .cmp,
    .cmp tbody,
    .cmp tr,
    .cmp th,
    .cmp td {
      display: block;
      width: 100%;
    }
    .group-row th {
      padding: 32px 0 8px;
    }
    tbody tr:not(.group-row) {
      padding: 12px 0 16px;
    }
    tbody tr:not(.group-row) th {
      width: 100%;
      padding: 4px 0 10px;
      font-family: var(--fc-font-display);
      font-size: 1.05rem;
    }
    tbody td {
      padding: 10px 12px;
      border-radius: var(--fc-radius-control);
    }
    tbody td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.75rem;
      font-weight: 650;
      color: var(--fc-text-3);
      margin-bottom: 4px;
    }
    td.us::before {
      color: var(--fc-accent-text);
    }
  }
  .fine {
    display: grid;
    gap: 24px;
  }
  .fine > div:first-child {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  @media (min-width: 900px) {
    .fine {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 48px;
    }
  }
  .sources {
    margin: 0 0 24px;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
    color: var(--fc-text-2);
  }
  .tm {
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
</style>
