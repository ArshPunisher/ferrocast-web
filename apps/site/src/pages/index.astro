---
import Base from '../layouts/Base.astro'
import HeroBraid from '../components/HeroBraid.astro'
import Story from '../components/Story.astro'
import Beat from '../components/Beat.astro'
import BanPanel from '../components/BanPanel.astro'
import Icon from '../components/Icon.astro'
import BrandMark from '../components/BrandMark.astro'
import { PAGES } from '../data/pages'
import { COMPANY } from '../data/company'
import { organization, softwareApplication } from '../data/schema'
---

<Base page={PAGES.home} schema={[softwareApplication, organization]}>
  <script is:inline>
    // every load of the home page plays the opening (On air, Spark drop, Level check). Set
    // before the banner is parsed so its start states hold from the first frame.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.documentElement.classList.add('fc-intro', 'intro-hold')
  </script>
  <section class="hero" data-hero>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free and open source · Version 1 in development</p>
        <h1 class="display-1">
          <span class="line">Your stream tools,</span>
          <span class="line">on your own PC.</span>
        </h1>
        <p class="lede">
          Alerts, overlays, merged chat, a bot and one-click bans for Twitch, YouTube and Kick.
          Keeps working when clouds don’t.
        </p>
        <div class="hero-ctas">
          <a href="/download/" class="btn btn-primary">
            Download
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#alerts" class="btn btn-secondary">
            See it work
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroBraid />
      </div>
    </div>
  </section>

  <section class="works-with" aria-label="Works with">
    <div class="container ww">
      <p class="ww-label">Works with</p>
      <ul>
        <li>
          <BrandMark name="twitch" size={26} label="Twitch" />
        </li>
        <li>
          <BrandMark name="youtube" size={30} label="YouTube" />
        </li>
        <li>
          <BrandMark name="kick" size={24} label="Kick" />
        </li>
        <li>
          <BrandMark name="obs" size={26} label="OBS Studio" />
        </li>
      </ul>
    </div>
  </section>

  <section class="desk-story" aria-label="Alerts, merged chat and tips">
    <div class="container">
      <Story kind="desk" side="left">
        <Beat kind="desk" n={1} id="alerts" chapter="Alerts">
          <h2 class="display-2">Alerts that tell you why.</h2>
          <p class="lede">
            Every follow, sub, bit, Super Chat, raid and tip gets its own look and sound. When one
            doesn’t play, the event log says why, like Twitch quietly hiding a follow.
          </p>
          <ul class="ticks">
            <li>
              <Icon name="play-circle" size={20} /> Test any alert with one click, nothing connected
            </li>
            <li>
              <Icon name="stack" size={20} /> A gold look for a 12-month sub, a big one for big tips
            </li>
            <li>
              <Icon name="queue" size={20} /> A queue you can pause, skip and replay mid-stream
            </li>
          </ul>
          <a href="/features/alerts/" class="text-link">
            How alerts work
          </a>
        </Beat>
        <Beat kind="desk" n={2} id="chat" chapter="Merged chat">
          <h2 class="display-2">Three chats. One lane.</h2>
          <p class="lede">
            Twitch, YouTube and Kick land in one list, each message marked with where it came from.
            Reply from the same box and it goes back to the right platform.
          </p>
          <a href="/features/chat-moderation/" class="text-link">
            How merged chat works
          </a>
        </Beat>
        <Beat kind="desk" n={3} id="tips" chapter="Tips">
          <h2 class="display-2">Tips go straight to you.</h2>
          <p class="lede">
            Viewers pay into your own Razorpay (UPI), Stripe or Ko-fi account. No middle step: we
            never hold your money and take no cut. Your legal name never appears on the tip page or
            in alerts.
          </p>
          <div class="pay">
            <BrandMark name="razorpay" size={22} label="Razorpay" />
            <BrandMark name="stripe" size={22} label="Stripe" />
            <BrandMark name="kofi" size={22} label="Ko-fi" />
          </div>
          <a href="/features/tips/" class="text-link">
            How tips work
          </a>
        </Beat>
      </Story>
    </div>
  </section>

  <section id="moderation" class="section mod" data-chapter="Moderation">
    <div class="container">
      <div class="reveal">
        <BanPanel />
      </div>
      <ul class="mod-points">
        <li class="reveal">
          <Icon name="siren" size={24} />
          <div>
            <h3>Panic mode</h3>
            <p>
              Followers-only, slow mode and held new accounts on every platform, alerts paused, in
              one keypress.
            </p>
          </div>
        </li>
        <li class="reveal" style="--i: 1">
          <Icon name="prohibit" size={24} />
          <div>
            <h3>One shared ban list</h3>
            <p>See who was banned where, by whom and why. Unban from the same place.</p>
          </div>
        </li>
        <li class="reveal" style="--i: 2">
          <Icon name="note-pencil" size={24} />
          <div>
            <h3>Notes on viewers</h3>
            <p>Leave a note on a regular or a troublemaker. Your mods see it next to their name.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section id="local-first" class="section" data-chapter="Local-first">
    <div class="container">
      <h2 class="display-2 bento-title reveal">It runs on your computer, not ours.</h2>
      <div class="bento">
        <article class="cell cell-offline reveal">
          <div class="status" aria-hidden="true">
            <div class="status-head">
              <Icon name="cloud-slash" size={20} />
              <span>Ferrocast servers</span>
              <span class="down">Unreachable</span>
            </div>
            <ul>
              {['Alerts', 'Merged chat', 'Bot', 'Moderation', 'Overlays in OBS'].map((n) => (
                <li>
                  <span>{n}</span>
                  <span class="ok">
                    <Icon name="check-circle" weight="fill" size={16} />
                    Running
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <div class="cell-text">
            <h3>Works without us</h3>
            <p>
              Alerts, chat, the bot and moderation run on your PC. If our servers vanished tomorrow,
              Twitch and YouTube would keep working.
            </p>
          </div>
        </article>
        <article class="cell cell-export reveal" style="--i: 1">
          <div class="files" aria-hidden="true">
            <span class="file mono">overlays.ferropack</span>
            <span class="file mono">commands.json</span>
            <span class="file mono">tips.csv</span>
          </div>
          <h3>Export everything</h3>
          <p>Overlays with their media, commands and history, in open formats. One click.</p>
        </article>
        <article class="cell cell-import reveal" style="--i: 2">
          <Icon name="arrow-square-in" size={28} />
          <h3>Bring your setup</h3>
          <p>Coming soon: import alerts and commands from StreamElements and Streamlabs.</p>
        </article>
        <article class="cell cell-light reveal" style="--i: 1">
          <Icon name="feather" size={28} />
          <div>
            <h3>Light while gaming</h3>
            <p>
              A Rust engine, a window that closes to the tray, and overlays that pause when OBS
              hides them.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="deck-story" aria-label="Setup, hotkeys and panic mode">
    <div class="container">
      <Story kind="deck" side="right">
        <Beat kind="deck" n={1} id="setup" chapter="Setup">
          <h2 class="display-2">Live in three clicks.</h2>
          <ol class="steps">
            <li>
              <h3>Sign in</h3>
              <p>
                One click per platform. Twitch shows a short code, you approve it in your browser.
              </p>
            </li>
            <li>
              <h3>Pick a look</h3>
              <p>Five themes, previewed live with sample alerts and chat.</p>
            </li>
            <li>
              <h3>Add to OBS</h3>
              <p>Ferrocast adds the browser source for you. Or copy the URL and paste it in.</p>
            </li>
          </ol>
          <a href="/docs/getting-started/" class="text-link">
            Read the getting started guide
          </a>
        </Beat>
        <Beat kind="deck" n={2} id="hotkeys">
          <h2 class="display-2">Hands stay on the game.</h2>
          <p class="lede">
            Test, replay, skip or pause alerts and mute text-to-speech from a hotkey, without
            tabbing out of your game.
          </p>
        </Beat>
        <Beat kind="deck" n={3} id="panic">
          <h2 class="display-2">One key when a raid hits.</h2>
          <p class="lede">
            Panic mode turns on followers-only, slow mode and held new accounts on every platform
            and pauses alerts and TTS.
          </p>
          <a href="/features/chat-moderation/" class="text-link">
            How panic mode works
          </a>
        </Beat>
      </Story>
    </div>
  </section>

  <section id="open-source" class="section pledge" data-chapter="Open source">
    <div class="container pledge-inner reveal">
      <h2 class="display-1">
        <span class="fc-chrome-text">Free stays free.</span>
      </h2>
      <p class="lede">
        Ferrocast is GPL-3.0. Nothing that is free today will move behind a paywall later. Pro only
        sells what costs us money to run, and it never talks to your audience.
      </p>
      <div class="pledge-links">
        <a href={COMPANY.github} class="btn btn-secondary" rel="noopener">
          <BrandMark name="github" size={18} />
          Read the source
        </a>
        <a href="/pricing/" class="btn btn-ghost">
          See pricing
        </a>
      </div>
    </div>
  </section>

  <section id="get-started" class="section final" data-chapter="Get started">
    <div class="container final-inner reveal">
      <div>
        <h2 class="display-2">Bring your stream home.</h2>
        <p class="lede">Coming to macOS, Windows and Linux. Free, with nothing to sign up for.</p>
      </div>
      <a href="/download/" class="btn btn-primary">
        Download
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</Base>

<script>
  import { realGpu } from '../scripts/gpu'
  // The banner's star field (home only). It loads right away rather than at idle, because
  // it is the page's opening animation; without WebGL the braid simply shows.
  const root = document.documentElement
  const hero = document.querySelector<HTMLElement>('[data-hero]')
  const stage = hero?.querySelector<HTMLElement>('.hero-visual')
  const show = () => root.classList.add('hero-burst')
  if (hero && root.classList.contains('fc-intro'))
    import('../scripts/intro')
      .then((m) => m.playIntro(hero))
      .catch(() => root.classList.remove('intro-hold'))
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
  // thousands of points every frame: real GPUs only, and not when saving data
  if (!hero || !stage || conn?.saveData || !realGpu()) show()
  else
    import('../scripts/hero-field')
      .then((m) => {
        if (!m.mountHeroField(hero, stage, { intro: root.classList.contains('fc-intro') })) show()
      })
      .catch(show)
</script>

<style>
  /* ---- banner star field and opening animation */
  .hero :global(.hero-field) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
  }
  /* headline lines: one block each, so the Level check cursor can read them in */
  .hero-copy h1 :global(.line) {
    display: block;
    position: relative;
    width: fit-content;
  }
  .hero-copy h1 {
    position: relative;
  }
  /* opening start states, held only while the intro is about to play (html.intro-hold);
     if its script never runs, the failsafe shows everything after 4 s */
  @keyframes intro-failsafe {
    to {
      opacity: 1;
    }
  }
  :global(html.intro-hold) .hero-copy .eyebrow,
  :global(html.intro-hold) .hero-copy h1 :global(.line),
  :global(html.intro-hold) .hero-copy .lede,
  :global(html.intro-hold) .hero-ctas {
    opacity: 0;
    animation: intro-failsafe 1ms 4s forwards;
  }
  @keyframes hero-visual-in {
    from {
      opacity: 0.3;
      clip-path: inset(-10% 100% -10% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(-10% -10% -10% 0);
    }
  }
  /* Spark drop: the braid waits for the burst, then the chats flow out of the hub (a wipe
     from the hub outward); if the particles never start it shows after 3.5 s */
  :global(html.fc-intro) .hero-visual {
    animation: hero-visual-in 700ms var(--fc-ease-out) 3.5s both;
  }
  :global(html.fc-intro.hero-burst) .hero-visual {
    animation: hero-visual-in 1000ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  .hero {
    position: relative;
    padding-top: 24px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 8px;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 24px;
    position: relative;
    z-index: 1;
  }
  .hero-copy h1 {
    max-width: 17ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  /* the braid has its own column (below the copy on phones): it never runs under text */
  .hero-visual {
    height: min(78vw, 400px);
  }
  .hero-visual :global(.hero-station) {
    height: 100%;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 16px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      min-height: calc(100svh - 96px);
      gap: 24px;
    }
    .hero-copy {
      padding-block: 32px;
    }
    .hero-visual {
      height: min(calc(100svh - 220px), 540px);
    }
  }
  /* big screens: the banner grows with the window (wider, larger headline and braid), up to
     a ceiling so it never turns into a poster */
  @media (min-width: 1440px) {
    .hero-grid {
      gap: clamp(24px, 3vw, 64px);
    }
    .hero-copy h1 {
      font-size: clamp(3.9rem, 4.1vw, 5.1rem);
    }
    .hero-copy .lede {
      font-size: clamp(1.125rem, 1.05vw, 1.3rem);
      max-width: 36em;
    }
    .hero-visual {
      height: min(calc(100svh - 200px), clamp(540px, 38vw, 700px));
    }
  }

  .works-with {
    border-block: 1px solid var(--fc-line);
  }
  .ww {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 40px;
    padding-block: 24px;
  }
  .ww-label {
    font-size: 0.875rem;
    color: var(--fc-text-3);
    font-weight: 550;
  }
  .ww ul {
    display: flex;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--fc-text-2);
    align-items: center;
  }

  .desk-story {
    border-top: 1px solid var(--fc-line);
    padding-block: 24px;
  }
  .deck-story {
    border-top: 1px solid var(--fc-line);
    padding-block: 24px;
  }
  @media (min-width: 960px) {
    .desk-story,
    .deck-story {
      padding-block: 40px;
    }
  }
  .pay {
    display: flex;
    gap: 18px;
    color: var(--fc-text-2);
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 4px 0;
    display: grid;
    gap: 12px;
    color: var(--fc-text-2);
  }
  .ticks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .ticks :global(svg) {
    color: var(--fc-accent-text);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* the moderation panel keeps its own dark look; the three points sit below it */
  .mod {
    border-top: 1px solid var(--fc-line);
  }
  .mod-points {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    gap: 28px;
  }
  .mod-points li {
    display: flex;
    gap: 16px;
  }
  .mod-points :global(svg) {
    color: var(--fc-accent-text);
    flex-shrink: 0;
  }
  .mod-points h3 {
    font-size: 1.125rem;
    margin-bottom: 6px;
  }
  .mod-points p {
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
  }
  @media (min-width: 900px) {
    .mod-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      border-top: 1px solid var(--fc-line);
      padding-top: 32px;
    }
    .mod-points li {
      padding-inline: 24px;
    }
    .mod-points li + li {
      border-left: 1px solid var(--fc-line);
    }
  }

  .bento-title {
    max-width: 16ch;
    margin-bottom: 40px;
  }
  .bento {
    display: grid;
    gap: 12px;
  }
  .cell {
    position: relative;
    overflow: hidden;
    background: var(--fc-surface-1);
    border: 1px solid var(--fc-line);
    border-radius: var(--fc-radius-panel);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cell h3 {
    font-size: 1.25rem;
  }
  .cell p {
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
    max-width: 62ch;
  }
  .cell > :global(svg) {
    color: var(--fc-accent-text);
    margin-bottom: 8px;
  }
  /* the offline cell: a status panel from the app, the words below it on solid surface */
  .cell-offline {
    padding: 0;
    gap: 0;
  }
  .status {
    margin: 20px 20px 0;
    padding: 16px 18px;
    border-radius: 14px;
    background: var(--fc-surface-2);
    border: 1px solid var(--fc-line);
    display: grid;
    gap: 12px;
    font-size: var(--fc-body-s);
  }
  .status-head {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fc-text-2);
    font-weight: 600;
  }
  .status-head .down {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--fc-text-3);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--fc-line-strong);
  }
  .status ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .status li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--fc-line);
    color: var(--fc-text);
  }
  .status .ok {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fc-ok);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .cell-text {
    display: grid;
    gap: 10px;
    padding: 20px 24px 24px;
  }
  .cell-export {
    background:
      linear-gradient(180deg, var(--fc-surface-1), var(--fc-surface-1)) padding-box,
      var(--fc-chrome) border-box;
    border-color: transparent;
  }
  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .file {
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--fc-surface-3);
    border: 1px solid var(--fc-line-strong);
    color: var(--fc-text-2);
  }
  @media (min-width: 768px) {
    .status {
      margin: 28px 32px 0;
    }
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .cell-offline {
      grid-column: span 4;
      grid-row: span 2;
    }
    .cell-text {
      padding: 24px 32px 32px;
    }
    .cell-export {
      grid-column: span 2;
    }
    .cell-import {
      grid-column: span 2;
    }
    .cell-light {
      grid-column: span 6;
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }
    .cell-light > :global(svg) {
      margin-bottom: 0;
    }
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    counter-reset: s;
  }
  .steps li {
    counter-increment: s;
    position: relative;
    padding: 16px 0 16px 48px;
    border-top: 1px solid var(--fc-line);
  }
  .steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 16px;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-family: var(--fc-font-mono);
    font-size: 0.8125rem;
    color: var(--fc-accent-text);
    border: 1px solid var(--fc-accent-line);
  }
  .steps h3 {
    font-size: 1.125rem;
    margin-bottom: 4px;
  }
  .steps p {
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
  }

  .pledge {
    border-block: 1px solid var(--fc-line);
    background: var(--fc-surface-inset);
  }
  .pledge-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .pledge-inner .lede {
    margin-inline: auto;
  }
  .pledge h2 {
    padding-bottom: 0.08em;
  }
  /* Liquid-metal type, tuned per theme so it stays readable. */
  .pledge h2 .fc-chrome-text {
    background-image: linear-gradient(180deg, #ffffff 0%, #d5dbe5 42%, #8d96a5 70%, #dfe4ec 100%);
  }
  :global(html[data-theme='light']) .pledge h2 .fc-chrome-text {
    background-image: linear-gradient(180deg, #0e1014 0%, #3b414c 55%, #0e1014 100%);
  }
  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme])) .pledge h2 .fc-chrome-text {
      background-image: linear-gradient(180deg, #0e1014 0%, #3b414c 55%, #0e1014 100%);
    }
  }
  .pledge-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .final-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
  }
  .final-inner > div {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .final-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
