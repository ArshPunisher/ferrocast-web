---
import Base from '../layouts/Base.astro'
import FerroHero from '../components/FerroHero.astro'
import VideoSlot from '../components/VideoSlot.astro'
import Icon from '../components/Icon.astro'
import BrandMark from '../components/BrandMark.astro'
import { PAGES } from '../data/pages'
import { COMPANY } from '../data/company'
import { organization, softwareApplication } from '../data/schema'
---

<Base page={PAGES.home} schema={[softwareApplication, organization]}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free and open source · Version 1 in development</p>
        <h1 class="display-1">Your stream tools, on your own PC.</h1>
        <p class="lede">
          Alerts, overlays, merged chat, a bot and one-click bans for Twitch, YouTube and Kick.
          Keeps working when clouds don’t.
        </p>
        <div class="hero-ctas">
          <a href="/download/" class="btn btn-primary">
            Download
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#alerts" class="btn btn-secondary">
            See it work
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <FerroHero />
      </div>
    </div>
  </section>

  <section class="works-with" aria-label="Works with">
    <div class="container ww">
      <p class="ww-label">Works with</p>
      <ul>
        <li>
          <BrandMark name="twitch" size={26} label="Twitch" />
        </li>
        <li>
          <BrandMark name="youtube" size={30} label="YouTube" />
        </li>
        <li>
          <BrandMark name="kick" size={24} label="Kick" />
        </li>
        <li>
          <BrandMark name="obs" size={26} label="OBS Studio" />
        </li>
      </ul>
    </div>
  </section>

  <section id="alerts" class="section">
    <div class="container split">
      <div class="split-copy reveal">
        <h2 class="display-2">Alerts that tell you why.</h2>
        <p class="lede">
          Every follow, sub, bit, Super Chat, raid and tip gets its own look and sound. When one
          doesn’t play, the event log says why, like Twitch quietly hiding a follow.
        </p>
        <ul class="ticks">
          <li>
            <Icon name="play-circle" size={20} /> Test any alert with one click, nothing connected
          </li>
          <li>
            <Icon name="stack" size={20} /> A gold look for a 12-month sub, a big one for big tips
          </li>
          <li>
            <Icon name="queue" size={20} /> A queue you can pause, skip and replay mid-stream
          </li>
        </ul>
        <a href="/features/alerts/" class="text-link">
          How alerts work
        </a>
      </div>
      <div class="reveal" style="--i: 1">
        <VideoSlot
          name="alert-fires"
          label="An alert rising onto a stream overlay as a viewer subscribes"
        />
      </div>
    </div>
  </section>

  <section class="section mod">
    <div class="container">
      <div class="mod-head reveal">
        <h2 class="display-1">One ban. Every platform.</h2>
        <p class="lede">
          Ban a hate-raider on Twitch, YouTube and Kick in one click. Panic mode locks chat down
          everywhere at once, from a single hotkey.
        </p>
      </div>
      <div class="reveal" style="--i: 1">
        <VideoSlot
          name="ban-everywhere"
          label="One ban button removing a spammer from Twitch, YouTube and Kick chat at once"
        />
      </div>
      <ul class="mod-points">
        <li class="reveal">
          <Icon name="siren" size={24} />
          <div>
            <h3>Panic mode</h3>
            <p>
              Followers-only, slow mode and held new accounts on every platform, alerts paused, in
              one keypress.
            </p>
          </div>
        </li>
        <li class="reveal" style="--i: 1">
          <Icon name="prohibit" size={24} />
          <div>
            <h3>One shared ban list</h3>
            <p>See who was banned where, by whom and why. Unban from the same place.</p>
          </div>
        </li>
        <li class="reveal" style="--i: 2">
          <Icon name="note-pencil" size={24} />
          <div>
            <h3>Notes on viewers</h3>
            <p>Leave a note on a regular or a troublemaker. Your mods see it next to their name.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="display-2 bento-title reveal">It runs on your computer, not ours.</h2>
      <div class="bento">
        <article class="cell cell-offline reveal">
          <div class="cell-art" aria-hidden="true">
            <div class="ring r1"></div>
            <div class="ring r2"></div>
            <div class="ring r3"></div>
            <Icon name="cloud-slash" size={44} />
          </div>
          <h3>Works without us</h3>
          <p>
            Alerts, chat, the bot and moderation run on your PC. If our servers vanished tomorrow,
            Twitch and YouTube would keep working.
          </p>
        </article>
        <article class="cell cell-export reveal" style="--i: 1">
          <div class="files" aria-hidden="true">
            <span class="file mono">overlays.ferropack</span>
            <span class="file mono">commands.json</span>
            <span class="file mono">tips.csv</span>
          </div>
          <h3>Export everything</h3>
          <p>Overlays with their media, commands and history, in open formats. One click.</p>
        </article>
        <article class="cell cell-import reveal" style="--i: 2">
          <Icon name="arrow-square-in" size={28} />
          <h3>Bring your setup</h3>
          <p>Import overlays, alerts and commands from StreamElements and Streamlabs.</p>
        </article>
        <article class="cell cell-tips reveal" style="--i: 1">
          <div class="pay" aria-hidden="true">
            <BrandMark name="razorpay" size={22} />
            <BrandMark name="stripe" size={22} />
            <BrandMark name="kofi" size={22} />
          </div>
          <h3>Tips without doxxing</h3>
          <p>
            Viewers pay straight into your own Razorpay (UPI), Stripe, PayPal or Ko-fi. Your legal
            name never appears on your tip page or in alerts, and we never hold your money.
          </p>
        </article>
        <article class="cell cell-light reveal" style="--i: 2">
          <Icon name="feather" size={28} />
          <h3>Light while gaming</h3>
          <p>
            A Rust engine, a window that closes to the tray, and overlays that pause when OBS hides
            them.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section setup">
    <div class="container setup-grid">
      <div class="reveal">
        <VideoSlot
          name="setup-3-clicks"
          label="Ferrocast first run: signing in to Twitch, picking a look, adding the overlay to OBS"
        />
      </div>
      <div class="setup-copy reveal" style="--i: 1">
        <h2 class="display-2">Live in three clicks.</h2>
        <ol class="steps">
          <li>
            <h3>Sign in</h3>
            <p>
              One click per platform. Twitch shows a short code, you approve it in your browser.
            </p>
          </li>
          <li>
            <h3>Pick a look</h3>
            <p>Five themes, previewed live with sample alerts and chat.</p>
          </li>
          <li>
            <h3>Add to OBS</h3>
            <p>Ferrocast adds the browser source for you. Or copy the URL and paste it in.</p>
          </li>
        </ol>
        <a href="/docs/getting-started/" class="text-link">
          Read the getting started guide
        </a>
      </div>
    </div>
  </section>

  <section class="section pledge">
    <div class="container pledge-inner reveal">
      <h2 class="display-1">
        <span class="fc-chrome-text">Free stays free.</span>
      </h2>
      <p class="lede">
        Ferrocast is GPL-3.0. Nothing that is free today will move behind a paywall later. Pro only
        sells what costs us money to run, and it never talks to your audience.
      </p>
      <div class="pledge-links">
        <a href={COMPANY.github} class="btn btn-secondary" rel="noopener">
          <BrandMark name="github" size={18} />
          Read the source
        </a>
        <a href="/pricing/" class="btn btn-ghost">
          See pricing
        </a>
      </div>
    </div>
  </section>

  <section class="section final">
    <div class="container final-inner reveal">
      <div>
        <h2 class="display-2">Bring your stream home.</h2>
        <p class="lede">Coming to macOS, Windows and Linux. Free, with nothing to sign up for.</p>
      </div>
      <a href="/download/" class="btn btn-primary">
        Download
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: 24px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 8px;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 24px;
    position: relative;
    z-index: 1;
  }
  .hero-copy h1 {
    max-width: 17ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .hero-visual {
    height: min(78vw, 420px);
    margin-inline: -16px;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 16px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      min-height: min(calc(100svh - 64px - 88px), 560px);
      gap: 24px;
    }
    .hero-copy {
      padding-block: 32px;
    }
    .hero-visual {
      height: min(calc(100svh - 220px), 540px);
      margin-inline: 0 -40px;
    }
  }

  .works-with {
    border-block: 1px solid var(--fc-line);
  }
  .ww {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 40px;
    padding-block: 24px;
  }
  .ww-label {
    font-size: 0.875rem;
    color: var(--fc-text-3);
    font-weight: 550;
  }
  .ww ul {
    display: flex;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--fc-text-2);
    align-items: center;
  }

  .split {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .split-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 64px;
    }
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 4px 0;
    display: grid;
    gap: 12px;
    color: var(--fc-text-2);
  }
  .ticks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .ticks :global(svg) {
    color: var(--fc-accent-text);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mod {
    background:
      radial-gradient(60% 50% at 50% 0%, var(--fc-accent-soft), transparent 70%), var(--fc-bg);
    border-top: 1px solid var(--fc-line);
  }
  .mod-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 48px;
  }
  .mod-head .lede {
    margin-inline: auto;
  }
  .mod-points {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    gap: 28px;
  }
  .mod-points li {
    display: flex;
    gap: 16px;
  }
  .mod-points :global(svg) {
    color: var(--fc-accent-text);
    flex-shrink: 0;
  }
  .mod-points h3 {
    font-size: 1.125rem;
    margin-bottom: 6px;
  }
  .mod-points p {
    color: var(--fc-text-2);
    font-size: 0.9375rem;
  }
  @media (min-width: 900px) {
    .mod-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      border-top: 1px solid var(--fc-line);
      padding-top: 32px;
    }
    .mod-points li {
      padding-inline: 24px;
    }
    .mod-points li + li {
      border-left: 1px solid var(--fc-line);
    }
  }

  .bento-title {
    max-width: 16ch;
    margin-bottom: 40px;
  }
  .bento {
    display: grid;
    gap: 12px;
  }
  .cell {
    position: relative;
    overflow: hidden;
    background: var(--fc-surface-1);
    border: 1px solid var(--fc-line);
    border-radius: var(--fc-radius-panel);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cell h3 {
    font-size: 1.25rem;
  }
  .cell p {
    color: var(--fc-text-2);
    font-size: 0.9375rem;
  }
  .cell > :global(svg) {
    color: var(--fc-accent-text);
    margin-bottom: 8px;
  }
  .cell-offline {
    min-height: 340px;
    justify-content: flex-end;
    background:
      radial-gradient(80% 70% at 70% 30%, rgb(52 97 245 / 0.28), transparent 70%),
      linear-gradient(160deg, var(--fc-surface-2), var(--fc-surface-inset));
  }
  .cell-offline p {
    max-width: 44ch;
  }
  .cell-art {
    position: absolute;
    top: 36px;
    right: 36px;
    width: 140px;
    height: 140px;
    display: grid;
    place-items: center;
    color: var(--fc-text);
  }
  .ring {
    position: absolute;
    border-radius: 999px;
    border: 1px solid var(--fc-accent-line);
  }
  .r1 {
    inset: 34px;
  }
  .r2 {
    inset: 14px;
    opacity: 0.6;
  }
  .r3 {
    inset: -8px;
    opacity: 0.3;
  }
  .cell-export {
    background:
      linear-gradient(180deg, var(--fc-surface-1), var(--fc-surface-1)) padding-box,
      var(--fc-chrome) border-box;
    border-color: transparent;
  }
  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .file {
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--fc-surface-3);
    border: 1px solid var(--fc-line-strong);
    color: var(--fc-text-2);
  }
  .cell-tips {
    background: linear-gradient(200deg, var(--fc-surface-2), var(--fc-surface-1) 60%);
  }
  .pay {
    display: flex;
    gap: 14px;
    color: var(--fc-text-2);
    margin-bottom: 12px;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .cell-offline {
      grid-column: span 4;
      grid-row: span 2;
      min-height: 420px;
      padding: 36px;
    }
    .cell-export {
      grid-column: span 2;
    }
    .cell-import {
      grid-column: span 2;
    }
    .cell-tips {
      grid-column: span 3;
    }
    .cell-light {
      grid-column: span 3;
    }
  }

  .setup {
    border-top: 1px solid var(--fc-line);
  }
  .setup-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .setup-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 64px;
    }
  }
  .setup-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    counter-reset: s;
  }
  .steps li {
    counter-increment: s;
    position: relative;
    padding: 16px 0 16px 48px;
    border-top: 1px solid var(--fc-line);
  }
  .steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 16px;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-family: var(--fc-font-mono);
    font-size: 0.8125rem;
    color: var(--fc-accent-text);
    border: 1px solid var(--fc-accent-line);
  }
  .steps h3 {
    font-size: 1.125rem;
    margin-bottom: 4px;
  }
  .steps p {
    color: var(--fc-text-2);
    font-size: 0.9375rem;
  }

  .pledge {
    border-block: 1px solid var(--fc-line);
    background: var(--fc-surface-inset);
  }
  .pledge-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .pledge-inner .lede {
    margin-inline: auto;
  }
  .pledge h2 {
    padding-bottom: 0.08em;
  }
  /* Liquid-metal type, tuned per theme so it stays readable. */
  .pledge h2 .fc-chrome-text {
    background-image: linear-gradient(180deg, #ffffff 0%, #d5dbe5 42%, #8d96a5 70%, #dfe4ec 100%);
  }
  :global(html[data-theme='light']) .pledge h2 .fc-chrome-text {
    background-image: linear-gradient(180deg, #0e1014 0%, #3b414c 55%, #0e1014 100%);
  }
  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme])) .pledge h2 .fc-chrome-text {
      background-image: linear-gradient(180deg, #0e1014 0%, #3b414c 55%, #0e1014 100%);
    }
  }
  .pledge-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .final-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
  }
  .final-inner > div {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .final-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>
