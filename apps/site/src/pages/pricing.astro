---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Icon from '../components/Icon.astro'
import { PAGES } from '../data/pages'
import { COMPANY, PRO, inr, taxNote } from '../data/company'

const page = PAGES.pricing
const usd = (amount: string) => `US$${amount}`

const free = [
  'Alerts with variations, sounds and test buttons',
  'Every overlay widget, every theme in the box',
  'Merged chat for Twitch, YouTube and Kick',
  'Ban everywhere, panic mode, filters and viewer notes',
  'Chatbot with commands and timers on your PC',
  'Tip page with zero cut; your legal name stays off it',
  'Text-to-speech with offline voices',
  'Export everything, and import from StreamElements and Streamlabs',
  'Stream insights for the last 30 days, with a free account',
  'Cloud mode with a free account: alerts, overlays, chat and the bot run on our servers for Twitch and Kick, with your PC off',
  'The web dashboard, with a free account',
]
const pro = [
  {
    t: 'YouTube from the cloud',
    d: 'Your YouTube chat and bot keep running on our servers with your PC off, or with no PC at all.',
  },
  {
    t: 'Smart moderation',
    d: 'A second look at doubtful chat in English, Hindi and Hinglish. You decide what happens, with one-click undo. Nothing is banned on its own.',
  },
  {
    t: 'Smart replies and stream recaps',
    d: 'Answers viewers’ questions only from facts you approve, and a short written recap after each stream.',
  },
  {
    t: 'A year of stream insights',
    d: 'Charts for every stream, the best times to stream, your top supporters and a CSV export. Free accounts keep 30 days.',
  },
  {
    t: '24/7 cloud bot',
    d: 'The bot you set up in the desktop app keeps answering when your PC is off, YouTube included. Cloud mode’s own bot for Twitch and Kick is free.',
  },
  {
    t: 'Dashboard from anywhere',
    d: 'Open your desktop app’s dashboard on your phone and invite your mods. Offline mode: with the cloud bot on, chat, bans and history work even when your PC is off.',
  },
  {
    t: 'Ferrocast voices',
    d: 'Natural text-to-speech voices from Google, in Hindi and English. 20,000 characters a month.',
  },
  {
    t: 'Discord bot',
    d: 'Posts when you go live and gives roles to your subs, members and tippers.',
  },
  {
    t: 'Cloud backups',
    d: 'Your setup backed up on each day it changes, locked on your PC before upload. We can’t read it.',
  },
  {
    t: 'Weekly email',
    d: 'An optional report of your week’s streams, sent only in weeks you streamed.',
  },
  {
    t: 'Tip branding and goal',
    d: 'Your colours and images on the tip page, and a tip goal. Your own tip address is coming later.',
  },
]
const promises = [
  {
    icon: 'lock-simple-open',
    t: 'Free stays free',
    d: 'Nothing that is free today will move behind Pro later.',
  },
  {
    icon: 'calendar-check',
    t: 'Your price is locked',
    d: 'You keep your price for at least 12 months from the day you subscribe.',
  },
  {
    icon: 'bell-simple',
    t: '60 days’ notice',
    d: 'Any price change is announced at least 60 days ahead.',
  },
  {
    icon: 'chat-slash',
    t: 'Never in your chat',
    d: 'Pro never posts to your audience and never brands your overlays.',
  },
]
---

<Base page={page}>
  <section class="head">
    <div class="container head-inner">
      <Breadcrumbs page={page} />
      <h1 class="display-2">Free forever. Pro for the parts that cost us money.</h1>
      <p class="lede">
        The app does everything on your computer, and cloud mode runs the basics on our servers,
        both free. Pro adds the parts that cost us real money to run.
      </p>
    </div>
  </section>

  <section class="container plans">
    <article class="plan plan-free">
      <header>
        <h2>Free</h2>
        <p class="price">
          <span class="amount">₹0</span>
          <span class="per">forever</span>
        </p>
        <p class="muted">
          The whole app with no account, no trial and no limits on streams. A free account adds
          cloud mode and the web dashboard.
        </p>
      </header>
      <ul class="checks">
        {free.map((f) => (
          <li>
            <Icon name="check" size={18} weight="bold" />
            {f}
          </li>
        ))}
      </ul>
      <p class="free-limits">
        Cloud mode keeps up to 200 MB of your media (20 MB a file). An account nobody uses for 30
        days sleeps until you sign in again.
      </p>
      <a href="/download/" class="btn btn-primary">
        Download
      </a>
    </article>

    <article class="plan plan-pro">
      <header>
        <h2>
          Pro <span class="chip">On sale now</span>
        </h2>
        <p class="sale-note" data-live-sale hidden></p>
        <p class="price">
          <s class="was" data-live-was="monthly" hidden></s>
          <span class="amount" data-live-price="monthly">
            {inr(PRO.monthlyInr)}
          </span>
          <span class="per">a month</span>
        </p>
        <p class="muted">
          or <s class="was-inline" data-live-was="yearly" hidden></s>
          <span data-live-price="yearly">{inr(PRO.yearlyInr)}</span> a year.
          <span
            data-live-usd
          >{`Approx. ${usd(PRO.monthlyUsdApprox)} a month or ${usd(PRO.yearlyUsdApprox)} a year.`}</span>
          Billed in INR through Razorpay. {taxNote()} Renews automatically until you cancel.
        </p>
      </header>
      <dl class="pro-list">
        {pro.map((p) => (
          <div>
            <dt>{p.t}</dt>
            <dd>{p.d}</dd>
          </div>
        ))}
      </dl>
      <p class="not-yet">
        <Icon name="check-circle" size={18} />
        Buy it in the app: Settings › Pro. Everything in Free works without it.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="display-3 promises-title">Promises you can hold us to</h2>
      <ul class="promises">
        {promises.map((p) => (
          <li class="reveal">
            <Icon name={p.icon} size={26} />
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section qa-wrap">
    <div class="container qa">
      <h2 class="display-3">Pricing questions</h2>
      <div class="qa-list">
        <details>
          <summary>Why is Pro priced in rupees?</summary>
          <p>
            Ferrocast is made in India and priced for India and other emerging markets first. You
            pay in INR through Razorpay; banks outside India convert at their own rate, so the
            dollar figure is an estimate.
          </p>
        </details>
        <details>
          <summary>Will a free feature ever become Pro?</summary>
          <p>
            No. Pro only adds things that run on our servers. The desktop app is GPL-3.0, so its
            features can’t be taken back.
          </p>
        </details>
        <details>
          <summary>Do you take a cut of my tips?</summary>
          <p>
            No, on Free or Pro. Tips go straight into your own payment account and the provider
            charges its usual fees.
          </p>
        </details>
        <details>
          <summary>What happens if I stop paying?</summary>
          <p>
            Pro’s cloud work stops, and the free app keeps working as before. Most Pro data stays
            for 30 days so you can download it, then we delete it. If we ever close a cloud feature,
            you get 180 days’ notice. See the <a href="/terms/#closing">terms</a>.
          </p>
        </details>
        <details>
          <summary>How do refunds work?</summary>
          <p>
            See the <a href="/refunds/">refund and cancellation policy</a>. You can cancel any time
            and keep Pro until the end of the period you paid for.
          </p>
        </details>
      </div>
      <!-- prettier-ignore -->
      <p class="muted more-q">More in the <a href="/faq/" class="text-link">FAQ</a>, or <a href="/contact/" class="text-link">contact {COMPANY.name}</a>.</p>
    </div>
  </section>
</Base>

<script>
  // Live prices from the relay (a sale, or a changed price). The static prices above stay
  // when the relay is slow, down, or older than this page (no /v1/pro/prices yet).
  const RELAY = 'https://ferrocast-relay.clearcraftlabs.com'
  type Live = {
    prices?: { monthly?: number; yearly?: number }
    list_prices?: { monthly?: number; yearly?: number }
    sale?: {
      headline?: string
      ends_at?: number | null
      was?: { monthly?: number; yearly?: number }
    } | null
  }
  const rupees = (paise: number) =>
    new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: paise % 100 === 0 ? 0 : 2,
    }).format(paise / 100)
  const isPaise = (n: unknown): n is number =>
    typeof n === 'number' && Number.isFinite(n) && n >= 100
  const live = async () => {
    const ctl = new AbortController()
    const t = setTimeout(() => ctl.abort(), 4000)
    try {
      const r = await fetch(`${RELAY}/v1/pro/prices`, { signal: ctl.signal })
      if (!r.ok) return
      const v = (await r.json()) as Live
      let changed = false
      for (const k of ['monthly', 'yearly'] as const) {
        const now = v.prices?.[k]
        const el = document.querySelector<HTMLElement>(`[data-live-price="${k}"]`)
        if (!isPaise(now) || !el) continue
        const text = rupees(now)
        if (el.textContent?.trim() !== text) changed = true
        el.textContent = text
        const was = v.sale?.was?.[k]
        const wasEl = document.querySelector<HTMLElement>(`[data-live-was="${k}"]`)
        if (wasEl && isPaise(was) && was > now) {
          wasEl.textContent = rupees(was)
          wasEl.setAttribute('aria-label', `was ${rupees(was)}`)
          wasEl.hidden = false
        }
      }
      // The dollar estimates are for the usual prices only.
      const usd = document.querySelector<HTMLElement>('[data-live-usd]')
      if (changed && usd) usd.hidden = true
      const note = document.querySelector<HTMLElement>('[data-live-sale]')
      if (note && v.sale?.headline) {
        const ends = v.sale.ends_at
          ? ` Ends ${new Date(v.sale.ends_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}.`
          : ''
        note.textContent = `${v.sale.headline}.${ends}`
        note.hidden = false
      }
    } catch {
      // Keep the static prices.
    } finally {
      clearTimeout(t)
    }
  }
  void live()

  // Pricing station: plan cards tilt a few degrees toward the pointer (fine pointers only).
  const ok = matchMedia(
    '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  )
  document.querySelectorAll<HTMLElement>('.plan').forEach((card) => {
    let raf = 0
    card.addEventListener('pointermove', (e) => {
      if (!ok.matches || raf) return
      raf = requestAnimationFrame(() => {
        raf = 0
        const r = card.getBoundingClientRect()
        const x = (e.clientX - r.left) / r.width - 0.5
        const y = (e.clientY - r.top) / r.height - 0.5
        card.style.setProperty('--ry', `${(x * 5).toFixed(2)}deg`)
        card.style.setProperty('--rx', `${(-y * 4).toFixed(2)}deg`)
      })
    })
    card.addEventListener('pointerleave', () => {
      if (raf) cancelAnimationFrame(raf)
      raf = 0
      card.style.removeProperty('--rx')
      card.style.removeProperty('--ry')
    })
  })
</script>

<style>
  .head {
    padding-block: 40px 32px;
  }
  .head-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .head h1 {
    max-width: 22ch;
  }
  @media (min-width: 1024px) {
    .head {
      padding-block: 72px 48px;
    }
  }
  .plans {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .plans {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 28px 24px;
    border-radius: var(--fc-radius-panel);
    border: 1px solid var(--fc-line);
    background: var(--fc-surface-1);
    transform: perspective(1400px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 500ms var(--fc-ease-out),
      box-shadow 500ms var(--fc-ease-out);
  }
  /* a subtle tilt toward the pointer: the plan card leans like a physical card */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .plan:hover {
      transition:
        transform 120ms linear,
        box-shadow 300ms var(--fc-ease-out);
      box-shadow: 0 30px 70px -40px rgb(2 4 10 / 0.7);
    }
  }
  @media (min-width: 640px) {
    .plan {
      padding: 36px;
    }
  }
  .plan-free {
    border-color: var(--fc-accent-line);
    background:
      radial-gradient(80% 60% at 100% 0%, var(--fc-accent-soft), transparent 70%),
      var(--fc-surface-1);
  }
  .plan header {
    display: grid;
    gap: 10px;
  }
  .plan h2 {
    font-size: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .plan h2 .chip {
    font-family: var(--fc-font-sans);
    letter-spacing: 0;
  }
  .sale-note {
    margin: 0 0 6px;
    font-weight: 600;
    color: var(--fc-molten-text, currentColor);
  }
  .was {
    margin-right: 10px;
    font-size: 1.375rem;
    font-weight: 600;
    opacity: 0.65;
  }
  .was-inline {
    opacity: 0.7;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .amount {
    font-family: var(--fc-font-display);
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--fc-text);
    line-height: 1;
  }
  .per {
    color: var(--fc-text-2);
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--fc-text);
  }
  .checks :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--fc-ok);
  }
  .free-limits {
    margin: 0;
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
  }
  .plan-free .btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .pro-list {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 1100px) {
    .pro-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 28px;
    }
  }
  .pro-list dt {
    font-weight: 650;
    color: var(--fc-text);
  }
  .pro-list dd {
    margin: 2px 0 0;
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
  }
  .not-yet {
    margin-top: auto;
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
    padding: 12px 14px;
    border-radius: var(--fc-radius-control);
    border: 1px dashed var(--fc-line-strong);
  }
  .promises-title {
    margin-bottom: 32px;
  }
  .promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  .promises li {
    display: grid;
    gap: 8px;
  }
  .promises :global(svg) {
    color: var(--fc-accent-text);
  }
  .promises h3 {
    font-size: 1.15rem;
  }
  .promises p {
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
  }
  @media (min-width: 768px) {
    .promises {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 48px;
    }
  }
  @media (min-width: 1100px) {
    .promises {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .qa-wrap {
    padding-top: 0;
  }
  .qa {
    display: grid;
    gap: 24px;
  }
  .qa-list {
    border-top: 1px solid var(--fc-line);
  }
  details {
    border-bottom: 1px solid var(--fc-line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    font-weight: 650;
    color: var(--fc-text);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--fc-font-mono);
    color: var(--fc-text-3);
    font-size: 1.25rem;
    transition: transform 200ms var(--fc-ease-out);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    color: var(--fc-text-2);
    padding-bottom: 20px;
    max-width: 70ch;
  }
  details a {
    color: var(--fc-accent-text);
  }
  @media (min-width: 900px) {
    .qa {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 48px;
    }
    .more-q {
      grid-column: 2;
    }
  }
</style>
