---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Bot from '../components/Bot.astro'
import Icon from '../components/Icon.astro'
import BrandMark from '../components/BrandMark.astro'
import { PAGES } from '../data/pages'
import { COMPANY, SITE } from '../data/company'
import { webPage } from '../data/schema'
import { betaAhead, latestStable } from '../data/releases'
import { kindOf, thanksPath } from '../data/downloads'

const stable = await latestStable()
const ahead = await betaAhead()
// Stable first. Before the first stable release the beta takes its place, as before.
const beta = stable ?? ahead
const isStable = stable !== null
const extraBeta = isStable ? ahead : null
const page = isStable
  ? {
      ...PAGES.download,
      title: 'Download Ferrocast for macOS, Windows and Linux',
      description: `Download Ferrocast ${stable.version} for macOS, Windows and Linux, free and open source, with install notes and checksums. Nothing to sign up for.`,
    }
  : PAGES.download
const mb = (bytes: number) => (bytes > 0 ? `${Math.round(bytes / 1_000_000)} MB` : '')
const released = beta?.publishedAt
  ? new Date(beta.publishedAt).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : ''
const platforms = [
  {
    os: 'mac',
    name: 'macOS',
    icon: 'apple-logo',
    builds: ['Apple Silicon (M1 and later)', 'Intel'],
    format: 'Disk image (.dmg)',
    tip: 'Not notarized yet: the first time, choose Open Anyway in System Settings, Privacy & Security. Only once.',
  },
  {
    os: 'windows',
    name: 'Windows',
    icon: 'windows-logo',
    builds: ['Windows 10 and 11, 64-bit'],
    format: 'Installer for your user account, no admin needed',
    tip: 'If SmartScreen warns, choose More info, then Run anyway. No admin rights needed.',
  },
  {
    os: 'linux',
    name: 'Linux',
    icon: 'linux-logo',
    builds: ['x86-64 and ARM64'],
    format: 'AppImage, .deb and .rpm',
    tip: 'Install the .deb or .rpm, or make the AppImage executable and run it.',
  },
]
/** A file's short name on its button: the format, not the whole label. */
const short = (url: string) => {
  const f = url.split('/').pop() ?? ''
  if (f.endsWith('.dmg')) return '.dmg'
  if (f.endsWith('-setup.exe')) return 'installer'
  if (f.endsWith('.AppImage')) return 'AppImage'
  if (f.endsWith('.deb')) return '.deb'
  if (f.endsWith('.rpm')) return '.rpm'
  return 'file'
}
const filesFor = (os: string) => beta?.assets.filter((a) => a.os === os) ?? []
---

<Base
  page={page}
  schema={[webPage(page.title, new URL(page.path, SITE.url).href, page.description)]}
>
  <section class="head">
    <div class="container head-grid">
      <div class="head-inner">
        <Breadcrumbs page={page} />
        {isStable ? (
          <>
            <h1 class="display-2">Download Ferrocast</h1>
            <p class="lede">
              Version <span class="mono">{stable.version}</span> is free on macOS, Windows and
              Linux, with nothing to sign up for.
            </p>
          </>
        ) : (
          <>
            <h1 class="display-2">Ferrocast is almost here.</h1>
            <p class="lede">
              Version 1 is being built in the open. The beta is free on macOS, Windows and Linux,
              with nothing to sign up for.
            </p>
          </>
        )}
      </div>
      <Bot />
    </div>
  </section>

  <section class="container" id={isStable ? 'get' : 'beta'} aria-labelledby="get-title">
    <h2 id="get-title" class="sr-only">
      {isStable ? 'Download Ferrocast' : 'Download the beta'}
    </h2>
    {beta && beta.assets.length > 0 ? (
      <p class="release" role="note">
        <Icon name={isStable ? 'seal-check' : 'flask'} size={18} />
        {isStable ? (
          // prettier-ignore
          <span><strong>Version <span class="mono">{beta.version}</span></strong>{released && `, ${released}`}. The stable release, with updates built in.</span>
        ) : (
          // prettier-ignore
          <span><strong>Beta <span class="mono">{beta.version}</span></strong>{released && `, ${released}`}. A test build: keep your old tools for big streams.</span>
        )}
        <span class="release-links">
          <a href={beta.url} rel="noopener">
            Release notes
          </a>
          {beta.checksums && (
            <a href={beta.checksums} rel="noopener">
              Checksums
            </a>
          )}
        </span>
      </p>
    ) : (
      <p class="release" role="note">
        <Icon name="hourglass-medium" size={18} />
        <span>The first beta isn’t out yet.</span>
        <span class="release-links">
          <a href={`${COMPANY.github}/releases`} rel="noopener" data-beta-releases>
            Releases on GitHub
          </a>
        </span>
      </p>
    )}
    <ul class="oses">
      {platforms.map((p) => {
        const files = filesFor(p.os)
        const [main, ...more] = files
        return (
          <li class="os" data-os={p.os} data-bot-excite>
            <div class="os-top">
              <Icon name={p.icon} size={32} weight="fill" />
              <span class="yours" hidden>
                Your system
              </span>
            </div>
            <h3>{p.name}</h3>
            <ul class="builds">
              {p.builds.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <p class="format">{p.format}</p>
            {main ? (
              <>
                <p class="plan">{p.tip}</p>
                <div class="get">
                  <a
                    class="btn btn-secondary"
                    href={thanksPath(main) ?? main.url}
                    data-beta-download
                    data-bot-excite
                    data-file={main.url}
                    data-dl-kind={kindOf(main.url)}
                  >
                    <Icon name="download-simple" size={18} />
                    {isStable ? 'Download' : 'Download beta'}
                    <span class="sr-only">
                      for {p.name} ({short(main.url)})
                    </span>
                  </a>
                  <span class="size">
                    {[short(main.url), mb(main.size)].filter(Boolean).join(', ')}
                  </span>
                </div>
                {more.length > 0 && (
                  <p class="more">
                    Also as{' '}
                    {more.map((a, i) => (
                      <>
                        {i > 0 && ' or '}
                        <a
                          href={thanksPath(a) ?? a.url}
                          data-beta-download
                          data-file={a.url}
                          data-dl-kind={kindOf(a.url)}
                          aria-label={`${short(a.url)} for ${p.name}`}
                        >
                          {short(a.url)}
                        </a>
                      </>
                    ))}
                  </p>
                )}
              </>
            ) : (
              <span class="soon">
                <Icon name="hourglass-medium" size={16} />
                <span class="sr-only">{p.name} download:</span>
                Coming soon
              </span>
            )}
          </li>
        )
      })}
    </ul>
    {isStable ? (
      <p class="after">
        Ferrocast updates itself to new stable releases, and never while you’re live.
      </p>
    ) : (
      <p class="after">
        A beta build offers new betas and stable releases by itself; once you’re on a stable release
        you get stable updates only. To try a beta, download it here. It never updates while you’re
        live.
      </p>
    )}
  </section>

  {extraBeta && (
    <section class="container" id="beta" aria-labelledby="beta-title">
      <div class="beta-offer">
        <Icon name="flask" size={22} />
        <div>
          <h2 id="beta-title">Want new features first? Get the beta.</h2>
          <p>
            Beta <span class="mono">{extraBeta.version}</span> is a test build of what comes next.
            It offers new betas and stable releases by itself, so keep your old tools for big
            streams.
          </p>
        </div>
        <a class="btn btn-secondary" href={extraBeta.url} rel="noopener" data-beta-releases>
          Get the beta
        </a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="notify">
        <div class="notify-copy">
          <h2 class="display-3">
            {isStable ? 'Hear about every release.' : 'Hear the moment it ships.'}
          </h2>
          <p class="lede">
            No mailing list needed. Follow releases on GitHub, or add the release feed to any feed
            reader.
          </p>
        </div>
        <div class="notify-actions">
          <a
            href={`${COMPANY.github}/releases`}
            class="btn btn-primary"
            rel="noopener"
            data-bot-excite
          >
            <BrandMark name="github" size={18} />
            Watch releases on GitHub
          </a>
          <a
            href={`${COMPANY.github}/releases.atom`}
            class="btn btn-secondary"
            rel="noopener"
            data-bot-excite
          >
            <Icon name="rss" size={18} />
            Release feed (Atom)
          </a>
          <p class="hint">
            On GitHub, choose <strong>Watch</strong>, then <strong>Custom</strong>, then
            <strong>Releases</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section build">
    <div class="container build-grid">
      <h2 class="display-3">Rather build it yourself?</h2>
      <div class="prose">
        <p>
          Ferrocast is GPL-3.0 and the source is public. The engine is written in Rust, the
          dashboard and overlays in TypeScript. Build instructions live in the repository README.
        </p>
        <!-- prettier-ignore -->
        <p><a href={COMPANY.github} rel="noopener">Engine and desktop app</a> · <a href={COMPANY.githubWeb} rel="noopener">Dashboard, overlays and this website</a></p>
        <p>
          New to Ferrocast? The <a href="/docs/getting-started/">getting started guide</a> shows
          what setup looks like.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Highlight the visitor's OS. Only a hint: every download stays visible.
  // iPads ask for desktop sites with a Mac user agent; touch support gives them away.
  // Phones, tablets and ChromeOS get no highlight, since none of them run the app.
  const ua = navigator.userAgent
  const touchMac = /Macintosh/i.test(ua) && navigator.maxTouchPoints > 1
  const os =
    /iPhone|iPad|iPod|Android|CrOS/i.test(ua) || touchMac
      ? null
      : /Mac/i.test(ua)
        ? 'mac'
        : /Win/i.test(ua)
          ? 'windows'
          : /Linux|X11/i.test(ua)
            ? 'linux'
            : null
  if (os) {
    const card = document.querySelector<HTMLElement>(`.os[data-os="${os}"]`)
    card?.classList.add('mine')
    card?.querySelector<HTMLElement>('.yours')?.removeAttribute('hidden')
    // The visitor's download is the page's main button.
    card?.querySelector('.get .btn')?.classList.replace('btn-secondary', 'btn-primary')
  }
</script>

<style>
  .release {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 0 0 16px;
    padding: 12px 16px;
    border-radius: var(--fc-radius-control);
    border: 1px solid var(--fc-line);
    background: var(--fc-surface-1);
    color: var(--fc-text-2);
  }
  .release :global(svg) {
    color: var(--fc-accent-text);
    flex: none;
  }
  .release strong {
    color: var(--fc-text);
  }
  .release-links {
    display: flex;
    gap: 16px;
    margin-left: auto;
    font-weight: 600;
  }
  .beta-offer {
    display: grid;
    gap: 12px 20px;
    margin-top: 40px;
    padding: 20px 24px;
    border-radius: var(--fc-radius-panel);
    border: 1px dashed var(--fc-line-strong);
    color: var(--fc-text-2);
  }
  .beta-offer > :global(svg) {
    color: var(--fc-accent-text);
  }
  .beta-offer h2 {
    font-size: 1.125rem;
    color: var(--fc-text);
    margin-bottom: 4px;
  }
  @media (min-width: 768px) {
    .beta-offer {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .get {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 6px;
  }
  .size {
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
  .more {
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
  .more a {
    font-weight: 600;
  }
  .after {
    margin-top: 14px;
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
  @media (min-width: 1024px) {
    .head {
      padding-block: 72px 48px;
    }
  }
  /* Sparky sits beside the heading, not on a row of its own. */
  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 32px;
  }
  .head-grid :global(.fc-bot .bot) {
    width: clamp(96px, 24vw, 200px);
  }
  .oses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .oses {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .os {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: var(--fc-radius-panel);
    border: 1px solid var(--fc-line);
    background: var(--fc-surface-1);
  }
  .os.mine {
    border-color: var(--fc-accent-line);
    background:
      radial-gradient(80% 60% at 100% 0%, var(--fc-accent-soft), transparent 70%),
      var(--fc-surface-1);
  }
  .os-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--fc-text);
    margin-bottom: 4px;
  }
  .yours {
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--fc-accent-text);
    border: 1px solid var(--fc-accent-line);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .yours[hidden] {
    display: none;
  }
  .os h3 {
    font-size: 1.5rem;
  }
  .builds {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--fc-text);
    font-weight: 550;
  }
  .format {
    color: var(--fc-text-2);
    font-size: var(--fc-body-s);
  }
  .plan {
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
  .soon {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding-inline: 14px;
    border-radius: var(--fc-radius-control);
    border: 1px dashed var(--fc-line-strong);
    color: var(--fc-text-2);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .notify {
    display: grid;
    gap: 28px;
    padding: 32px 24px;
    border-radius: var(--fc-radius-panel);
    border: 1px solid var(--fc-line);
    background:
      radial-gradient(70% 90% at 0% 100%, var(--fc-accent-soft), transparent 70%),
      var(--fc-surface-1);
  }
  .notify-copy {
    display: grid;
    gap: 12px;
  }
  .notify-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-content: center;
  }
  .hint {
    width: 100%;
    color: var(--fc-text-3);
    font-size: 0.875rem;
  }
  @media (min-width: 900px) {
    .notify {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      padding: 48px;
    }
  }
  @media (max-width: 480px) {
    .notify-actions .btn {
      width: 100%;
    }
  }
  .build {
    padding-top: 0;
  }
  .build-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .build-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 48px;
    }
  }
</style>
